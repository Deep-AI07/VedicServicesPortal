        function initDynamicPanchang() {
            const now = new Date();
            const dayOfWeek = now.getDay();
            const dayData = panchangDaysData[dayOfWeek] || panchangDaysData[4];
            const currentMins = now.getHours() * 60 + now.getMinutes();

            // Date & Time formatting
            const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            // Update modal text elements
            const locDateEl = document.getElementById('panchangLocationDate');
            if (locDateEl) locDateEl.textContent = `Ramnagar, Jam-khambhalya • ${dateStr}`;

            const dayLordEl = document.getElementById('panchangDayLord');
            if (dayLordEl) dayLordEl.textContent = `${dayData.dayName} • ${dayData.lord}`;

            const clockEl = document.getElementById('panchangClock');
            if (clockEl) clockEl.textContent = timeStr;

            const tithiEl = document.getElementById('panchangTithi');
            if (tithiEl) tithiEl.textContent = dayData.tithi;

            const nakshatraEl = document.getElementById('panchangNakshatra');
            if (nakshatraEl) nakshatraEl.textContent = dayData.nakshatra;

            const yogaEl = document.getElementById('panchangYoga');
            if (yogaEl) yogaEl.textContent = dayData.yoga;

            const karanaEl = document.getElementById('panchangKarana');
            if (karanaEl) karanaEl.textContent = dayData.karana;

            const abhijitEl = document.getElementById('panchangAbhijit');
            if (abhijitEl) abhijitEl.textContent = dayData.abhijit;

            const amritEl = document.getElementById('panchangAmrit');
            if (amritEl) amritEl.textContent = dayData.amrit;

            const brahmaEl = document.getElementById('panchangBrahma');
            if (brahmaEl) brahmaEl.textContent = dayData.brahma;

            const vijayaEl = document.getElementById('panchangVijaya');
            if (vijayaEl) vijayaEl.textContent = dayData.vijaya;

            const rahuEl = document.getElementById('panchangRahu');
            if (rahuEl) rahuEl.textContent = dayData.rahu;

            const yamaEl = document.getElementById('panchangYama');
            if (yamaEl) yamaEl.textContent = dayData.yama;

            const gulikaEl = document.getElementById('panchangGulika');
            if (gulikaEl) gulikaEl.textContent = dayData.gulika;

            const durEl = document.getElementById('panchangDur');
            if (durEl) durEl.textContent = dayData.dur;

            // Live status indicators
            const statusEl = document.getElementById('panchangLiveStatus');
            const statusDot = document.getElementById('panchangStatusDot');
            const navPillEl = document.getElementById('navMuhuratPill');
            const navIconEl = document.getElementById('navMuhuratIcon');
            const drawerPillEl = document.getElementById('drawerMuhuratPill');
            const drawerIconEl = document.getElementById('drawerMuhuratIcon');

            const isRahuKaal = (currentMins >= dayData.rahuStartMins && currentMins < dayData.rahuEndMins);
            const isAbhijit = (currentMins >= dayData.abhijitStartMins && currentMins < dayData.abhijitEndMins);

            if (isRahuKaal) {
                if (statusEl) {
                    statusEl.textContent = "⚠️ Rahu Kaal Active (Avoid New Rites)";
                    statusEl.className = "fw-bold small text-danger";
                }
                if (statusDot) statusDot.style.background = "#ef4444";
                if (navPillEl) {
                    navPillEl.textContent = `⚠️ Rahu Kaal (${dayData.rahu.split(' - ')[0]})`;
                    if (navPillEl.parentElement) navPillEl.parentElement.title = `Rahu Kaal Active: ${dayData.rahu} (Inauspicious)`;
                }
                if (navIconEl) navIconEl.textContent = "⚠️";
                if (drawerPillEl) drawerPillEl.textContent = `Rahu Kaal: ${dayData.rahu} (Inauspicious)`;
                if (drawerIconEl) drawerIconEl.textContent = "⚠️";
            } else if (isAbhijit) {
                if (statusEl) {
                    statusEl.textContent = "🟢 Live Now: Abhijit Muhurat (Supreme Auspicious)";
                    statusEl.className = "fw-bold small text-success";
                }
