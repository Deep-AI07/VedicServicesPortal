                                    <div class="text-muted small" style="font-size: 11px;">
                                        <span class="text-saffron fw-semibold">${s.badge}</span> • ${s.duration}
                                    </div>
                                </div>
                            </div>
                            <div class="text-end d-flex align-items-center gap-2">
                                <div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold fs-6">₹${s.price.toLocaleString()}</span>
                                    <small class="d-block text-muted-sacred" style="font-size: 9px;">Dakshina</small>
                                </div>
                                <a href="/Booking/Create?serviceId=${s.id}" class="btn-stitch-primary py-1 px-2 small text-decoration-none" style="font-size: 11px;">
                                    Book →
                                </a>
                            </div>
                        </div>`;
                });
                listEl.innerHTML = html;
                return;
            }

            // User has typed 1 or more characters!
            const matchedServices = searchSacredDatabase.services.filter(s => 
                s.name.toLowerCase().includes(q) ||
                s.category.toLowerCase().includes(q) ||
                s.badge.toLowerCase().includes(q) ||
                s.desc.toLowerCase().includes(q)
            );

            const matchedPandits = searchSacredDatabase.pandits.filter(p =>
                p.name.toLowerCase().includes(q) ||
                p.gurukul.toLowerCase().includes(q) ||
                p.spec.toLowerCase().includes(q)
            );

            const totalCount = matchedServices.length + matchedPandits.length;

            if (titleEl) titleEl.textContent = `✨ Suggestions for "${query}":`;
            if (countEl) countEl.textContent = `${totalCount} ${totalCount === 1 ? 'Match' : 'Matches'} Found`;

            if (totalCount === 0) {
                listEl.innerHTML = `
