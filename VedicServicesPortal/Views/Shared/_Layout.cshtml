            }

            if (!q) {
                // Show Popular predefined services
                if (titleEl) titleEl.textContent = "✨ Popular Sacred Ceremonies:";
                if (countEl) countEl.textContent = `${searchSacredDatabase.services.length} Ceremonies Available`;

                let html = "";
                searchSacredDatabase.services.slice(0, 6).forEach(s => {
                    html += `
