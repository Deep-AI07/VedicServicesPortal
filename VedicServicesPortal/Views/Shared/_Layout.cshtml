                }
                else if (lower.includes("pandit") || lower.includes("acharya") || lower.includes("verified") || lower.includes("gurukul") || lower.includes("purohit")) {
                    answer = `
                        <p class="mb-1"><strong>🧘 Our Verified Gurukul Pandits:</strong></p>
                        <p class="mb-1" style="font-size: 12px;">All our 8 Acharyas are certified scholars with 8 to 22+ years of Vedic sadhana:</p>
                        <ul class="mb-2 ps-3" style="font-size: 12px;">
                            <li><strong>Acharya Vidyadhar Shukla:</strong> 22+ Yrs (Varanasi Sanskrit Vishwavidyalaya)</li>
                            <li><strong>Pandit Raghavan Namboodiri:</strong> 18+ Yrs (Kerala Tantra Vidyapeeth)</li>
                            <li><strong>Pandit Rameshwar Joshi:</strong> 15+ Yrs (Kashi Vidyapeeth Parishad)</li>
                            <li><strong>Pandit Ramesh Sharma:</strong> 10+ Yrs (Shukla Yajurveda)</li>
                            <li><strong>Pandit Suresh Trivedi:</strong> 12+ Yrs (Griha Pravesh &amp; Vastu)</li>
