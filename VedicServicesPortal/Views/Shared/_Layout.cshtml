        function openContactModal() {
            document.getElementById('contactModal').classList.add('active');
        }
        function closeContactModal() {
            document.getElementById('contactModal').classList.remove('active');
        }
        function handleContactSubmit(e) {
            e.preventDefault();
            document.getElementById('contactAcharyaForm').classList.add('d-none');
            document.getElementById('contactSuccessMsg').classList.remove('d-none');
            setTimeout(() => {
                closeContactModal();
                document.getElementById('contactAcharyaForm').classList.remove('d-none');
                document.getElementById('contactSuccessMsg').classList.add('d-none');
            }, 2500);
        }

        // Close modals on clicking overlay backdrop
        window.addEventListener('click', function (e) {
            if (e.target.classList.contains('stitch-modal-overlay')) {
                e.target.classList.remove('active');
            }

            // Close Admin Nav Dropdown if clicked outside
            const adminContainer = document.getElementById('adminNavDropdownContainer');
            const adminMenu = document.getElementById('adminNavDropdownMenu');
            if (adminMenu && adminContainer && !adminContainer.contains(e.target)) {
                adminMenu.classList.remove('show');
            }

            // Close User Nav Dropdown if clicked outside
            const userContainer = document.getElementById('userNavDropdownContainer');
            const userMenu = document.getElementById('userNavDropdownMenu');
            if (userMenu && userContainer && !userContainer.contains(e.target)) {
                userMenu.classList.remove('show');
                userContainer.classList.remove('show');
            }
        });

        function toggleAdminNavDropdown(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const adminMenu = document.getElementById('adminNavDropdownMenu');
            if (adminMenu) {
                adminMenu.classList.toggle('show');
            }
        }

        function toggleUserNavDropdown(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const userContainer = document.getElementById('userNavDropdownContainer');
            const userMenu = document.getElementById('userNavDropdownMenu');
            if (userMenu) {
                userMenu.classList.toggle('show');
                if (userContainer) userContainer.classList.toggle('show');
            }
        }

        // Browser Back Button / bfcache reload fix
        // When user navigates back using browser back button, force page reload so server validates authentication
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2)) {
                window.location.reload();
