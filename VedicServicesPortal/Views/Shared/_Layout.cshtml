@using Microsoft.AspNetCore.Http
@{
    var portalSettings = SiteSettingsService.GetSettings();
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(portalSettings.BrandName) | @(portalSettings.BrandTagline)</title>
    <meta name="description" content="@(portalSettings.SiteDescription)" />

    <!-- GOOGLE FONTS (Playfair Display for sacred headlines, Plus Jakarta Sans for modern UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- BOOTSTRAP & CUSTOM STITCH STYLES -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <!-- ==========================================================================
         TOP HEADER NAVIGATION (STITCH DESIGN)
         ========================================================================== -->
    <header class="stitch-navbar">
        <div class="stitch-nav-inner">
            <!-- Brand Logo Lockup -->
            <a asp-controller="Home" asp-action="Index" class="stitch-brand group">
                <div class="stitch-brand-badge">
                    <span class="stitch-brand-om">@(portalSettings.BrandLogoOm ?? "ॐ")</span>
                </div>
                <div class="stitch-brand-text">
                    <span class="stitch-brand-name">@(portalSettings.BrandName)</span>
                    <span class="stitch-brand-tagline">@(portalSettings.BrandTagline)</span>
                </div>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="d-none d-lg-flex align-items-center">
                <ul class="stitch-nav-links">
                    <li>
                        <a asp-controller="Home" asp-action="Index"
                           class="stitch-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            Home
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Service" asp-action="Index"
                           class="stitch-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Service" ? "active" : "")">
                            Services
                        </a>
                    </li>
                    <li>
                        <a href="/#pandits" class="stitch-nav-link">
                            Pandits
                        </a>
                    </li>

                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item dropdown position-relative" id="adminNavDropdownContainer">
                                <div class="d-inline-flex align-items-center">
                                    <a asp-controller="Admin" asp-action="Dashboard" 
                                       class="stitch-nav-link text-primary-maroon fw-bold d-inline-flex align-items-center gap-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                                       id="adminCenterMainLink">
                                        <span>🛡️ Admin Center</span>
                                    </a>
                                    <button type="button" 
                                            class="btn btn-sm btn-link text-primary-maroon p-0 ms-1 border-0" 
                                            id="adminNavDropdownToggle" 
                                            onclick="toggleAdminNavDropdown(event)"
                                            style="text-decoration: none; font-size: 11px; vertical-align: middle;"
                                            title="Quick Navigation Menu">
                                        ▼
                                    </button>
                                </div>
                                <ul class="dropdown-menu border-0 shadow-lg rounded-4 p-2" id="adminNavDropdownMenu" style="border: 1px solid #dfbfbc !important; min-width: 230px;">
                                    <li><a class="dropdown-item rounded-3 py-2 fw-semibold text-deep-maroon" asp-controller="Admin" asp-action="Dashboard">📊 Dashboard Overview</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Bookings">📋 Ritual Bookings</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Users">👥 Devotees &amp; Users (Passwords)</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Services">🪔 Sacred Services</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Pandits">🧘 Vedic Pandits</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="TimeSlots">🕐 Muhurat Slots</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item rounded-3 py-2 fw-bold text-saffron" asp-controller="Admin" asp-action="Settings">⚙️ Brand &amp; Acharya Desk</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a asp-controller="Booking" asp-action="MyBookings"
                                   class="stitch-nav-link d-inline-flex align-items-center gap-1 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" && ViewContext.RouteData.Values["action"]?.ToString() == "MyBookings" ? "active" : "")">
                                    <span>My Bookings</span>
                                    <span class="stitch-badge-pill">Bookings</span>
                                </a>
                            </li>
                        }
                    }

                    <li>
                        <a href="/#about" class="stitch-nav-link">
                            About
                        </a>
                    </li>
                    <li>
                        <button type="button" class="stitch-nav-link border-0 bg-transparent p-0" onclick="openContactModal()">
                            Contact
                        </button>
                    </li>
                </ul>
            </nav>

            <!-- Trailing Action Suite -->
            <div class="d-flex align-items-center gap-2 gap-lg-3 flex-shrink-0">
                <!-- Today's Panchang Pill Trigger -->
                <button type="button" onclick="openPanchangModal()" class="stitch-muhurat-pill d-none d-xl-inline-flex" title="View Auspicious Muhurats &amp; Panchang for Today">
                    <span id="navMuhuratIcon">✨</span>
                    <span id="navMuhuratPill">Today's Muhurat: 11:48 AM (Abhijit)</span>
                </button>

                <!-- Search Icon Trigger -->
                <button type="button" onclick="openSearchModal()" class="stitch-icon-btn" aria-label="Search rituals" title="Search Sacred Ceremonies">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </button>

                <!-- User Auth State or Login / Register -->
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <div class="dropdown stitch-user-dropdown d-none d-md-block" id="userNavDropdownContainer">
                        <button class="stitch-user-btn" type="button" id="userNavDropdownToggle" onclick="toggleUserNavDropdown(event)" aria-expanded="false" title="Devotee Account Profile">
                            <span class="stitch-user-avatar">
                                @(Context.Session.GetString("UserName")?.Substring(0, 1).ToUpper() ?? "ॐ")
                            </span>
                            <span class="stitch-user-name">
                                Namaste, <strong class="text-deep-maroon">@(Context.Session.GetString("UserName")?.Split(' ')[0] ?? "Devotee")</strong>
                            </span>
                            <span class="stitch-user-caret">▼</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-right shadow-lg border-0 rounded-4 p-2 stitch-user-menu" id="userNavDropdownMenu" style="border: 1px solid #dfbfbc !important; min-width: 220px;">
                            <li class="px-3 py-2 border-bottom mb-2" style="border-color: rgba(223, 191, 188, 0.4) !important;">
                                <div class="small text-muted-sacred" style="font-size: 11px;">Signed in as</div>
                                <div class="fw-bold text-deep-maroon text-truncate">@Context.Session.GetString("UserName")</div>
                                @if (Context.Session.GetString("UserRole") == "Admin")
                                {
                                    <span class="badge bg-danger text-white rounded-pill px-2 py-0.5 mt-1" style="font-size: 10px;">🛡️ Administrator</span>
                                }
                                else
                                {
                                    <span class="badge bg-sacred-container text-deep-maroon rounded-pill px-2 py-0.5 mt-1" style="font-size: 10px;">🙏 Devotee</span>
                                }
                            </li>
                            @if (Context.Session.GetString("UserRole") == "Admin")
                            {
                                <li>
                                    <a asp-controller="Admin" asp-action="Dashboard" class="dropdown-item rounded-3 py-2 small fw-semibold text-deep-maroon">
                                        📊 Admin Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Admin" asp-action="Bookings" class="dropdown-item rounded-3 py-2 small">
                                        📋 Manage All Bookings
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a asp-controller="Booking" asp-action="MyBookings" class="dropdown-item rounded-3 py-2 small fw-semibold text-deep-maroon">
                                        📋 My Bookings &amp; Invoices
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a asp-controller="Account" asp-action="Logout" class="dropdown-item rounded-3 py-2 small fw-bold text-danger">
                                    🚪 Sign Out
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-none d-md-flex align-items-center gap-2 border-end pe-3 me-1" style="border-color: rgba(223, 191, 188, 0.6) !important;">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-link text-deep-maroon fw-semibold text-decoration-none px-3 py-1 small">
                            Login
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn-stitch-outline py-1 px-3 small">
                            Register
                        </a>
                    </div>
                }

                <!-- Primary CTA: "Book a Puja" -->
                <a asp-controller="Service" asp-action="Index" class="btn-stitch-primary d-none d-sm-inline-flex">
                    <span>Book a Puja</span>
                    <span>→</span>
                </a>

                <!-- Mobile Menu Toggle Button -->
                <button type="button" class="d-lg-none stitch-icon-btn fs-4 border-0" id="mobileMenuToggleBtn" aria-label="Toggle Menu">
                    ☰
                </button>
            </div>
        </div>

        <!-- Mobile Slideout Menu -->
        <div class="stitch-mobile-drawer" id="mobileDrawer">
            <a asp-controller="Home" asp-action="Index" class="stitch-mobile-link">Home</a>
            <a asp-controller="Service" asp-action="Index" class="stitch-mobile-link">Services</a>
            <a href="/#pandits" class="stitch-mobile-link" onclick="toggleMobileDrawer()">Pandits</a>

            @if (Context.Session.GetInt32("UserId") != null)
            {
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="stitch-mobile-link text-danger fw-bold">🛡️ Admin Dashboard</a>
                    <a asp-controller="Admin" asp-action="Bookings" class="stitch-mobile-link ps-3 small">📋 Manage Bookings</a>
                    <a asp-controller="Admin" asp-action="Users" class="stitch-mobile-link ps-3 small">👥 Devotees &amp; Users (Passwords)</a>
                    <a asp-controller="Admin" asp-action="Services" class="stitch-mobile-link ps-3 small">🪔 Manage Services</a>
                    <a asp-controller="Admin" asp-action="Pandits" class="stitch-mobile-link ps-3 small">🧘 Manage Pandits</a>
                    <a asp-controller="Admin" asp-action="TimeSlots" class="stitch-mobile-link ps-3 small">🕐 Muhurat Slots</a>
                    <a asp-controller="Admin" asp-action="Settings" class="stitch-mobile-link ps-3 small text-saffron fw-semibold">⚙️ Brand &amp; Acharya Desk</a>
                }
                else
                {
                    <a asp-controller="Booking" asp-action="MyBookings" class="stitch-mobile-link">My Bookings</a>
                }
            }

            <button type="button" onclick="openPanchangModal(); toggleMobileDrawer();" class="stitch-mobile-link border-0 bg-transparent text-start w-100 text-saffron fw-semibold">
                <span id="drawerMuhuratIcon">✨</span> <span id="drawerMuhuratPill">Today's Muhurat: 11:48 AM (Abhijit)</span>
            </button>
            <a href="/#about" class="stitch-mobile-link" onclick="toggleMobileDrawer()">About</a>
            <button type="button" onclick="openContactModal(); toggleMobileDrawer();" class="stitch-mobile-link border-0 bg-transparent text-start w-100">
                @(portalSettings.AcharyaDeskTitle)
            </button>

            <div class="pt-3 mt-2 border-top d-flex gap-2" style="border-color: rgba(223, 191, 188, 0.4) !important;">
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <a asp-controller="Account" asp-action="Logout" class="btn-stitch-outline flex-fill text-center text-decoration-none">
                        Logout (@Context.Session.GetString("UserName")?.Split(' ')[0])
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-stitch-outline flex-fill text-center text-decoration-none">
                        Login
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn-stitch-secondary flex-fill text-center text-decoration-none">
                        Register
                    </a>
                }
                <a asp-controller="Service" asp-action="Index" class="btn-stitch-primary flex-fill text-center text-decoration-none">
                    Book Puja
                </a>
            </div>
        </div>
    </header>

    <!-- ==========================================================================
         MAIN VIEW CONTENT
         ========================================================================== -->
    <main role="main" class="flex-grow-1" id="mainContent">
        @RenderBody()
    </main>

    <!-- ==========================================================================
         VEDIC 4-COLUMN FOOTER (STITCH REPLICATION)
         ========================================================================== -->
    <footer class="stitch-footer" id="contact">
        <div class="stitch-footer-inner">
            <div class="row g-4 mb-4">
                <!-- Column 1: Brand story -->
                <div class="col-lg-4 col-md-6">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-2 mb-3 text-decoration-none">
                        <span class="fs-4 text-deep-maroon font-serif fw-bold">@(portalSettings.BrandLogoOm ?? "ॐ")</span>
                        <span class="font-serif fs-4 fw-bold text-deep-maroon">@(portalSettings.BrandName)</span>
                    </a>
                    <p class="small text-muted-sacred mb-4" style="line-height: 1.7;">
                        @(portalSettings.BrandStory)
                    </p>
                    <div class="d-flex align-items-center gap-2 text-saffron small fw-bold tracking-wider">
                        <span>🛡️</span>
                        <span>@(portalSettings.GuaranteeBadgeText)</span>
                    </div>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <h5 class="stitch-footer-title">Quick Links</h5>
                    <ul class="stitch-footer-links">
                        <li><a asp-controller="Home" asp-action="Index" class="stitch-footer-link">Home</a></li>
                        <li><a asp-controller="Service" asp-action="Index" class="stitch-footer-link">Sacred Pujas &amp; Homas</a></li>
                        <li><a href="/#pandits" class="stitch-footer-link">Verified Pandits</a></li>
                        <li><button type="button" onclick="openPanchangModal()" class="stitch-footer-link">Muhurat Calendar</button></li>
                        <li><a href="/#about" class="stitch-footer-link">About Vedic Heritage</a></li>
                        <li><button type="button" onclick="openContactModal()" class="stitch-footer-link">Temple Seva</button></li>
                    </ul>
                </div>

                <!-- Column 3: Sacred Pujas -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="stitch-footer-title">Popular Pujas</h5>
                    <ul class="stitch-footer-links">
                        <li><a asp-controller="Service" asp-action="Index" class="stitch-footer-link">Ganesh Puja &amp; Havan</a></li>
                        <li><a asp-controller="Service" asp-action="Index" class="stitch-footer-link">Satyanarayan Katha</a></li>
                        <li><a asp-controller="Service" asp-action="Index" class="stitch-footer-link">Griha Pravesh &amp; Vastu Shanti</a></li>
                        <li><a asp-controller="Service" asp-action="Index" class="stitch-footer-link">Navgraha Shanti Puja</a></li>
                        <li><a asp-controller="Service" asp-action="Index" class="stitch-footer-link">Maha Mrityunjaya Jaap</a></li>
                        <li><button type="button" onclick="openContactModal()" class="stitch-footer-link">Vedic Astrology Consultation</button></li>
                    </ul>
                </div>

                <!-- Column 4: Contact Acharya Desk -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="stitch-footer-title">@(portalSettings.AcharyaDeskTitle)</h5>
                    <ul class="stitch-footer-links">
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-primary-maroon">✉️</span>
                            <a href="mailto:@(portalSettings.ContactEmail)" class="small text-muted-sacred text-decoration-none">@(portalSettings.ContactEmail)</a>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-primary-maroon">📞</span>
                            <a href="tel:@(portalSettings.ContactPhone.Replace(" ", "").Replace("-", ""))" class="small text-muted-sacred text-decoration-none fw-bold">@(portalSettings.ContactPhone)</a>
                        </li>
                        <li class="d-flex align-items-start gap-2">
                            <span class="text-primary-maroon">📍</span>
                            <span class="small text-muted-sacred">@(portalSettings.ContactAddress)</span>
                        </li>
                    </ul>
                    <div class="mt-3 p-3 rounded-3" style="background: #fff1e9; border: 1px solid rgba(223, 191, 188, 0.6);">
                        <p class="small fw-bold text-saffron mb-1">Devotee Helpline Hours:</p>
                        <p class="small text-muted-sacred mb-0">@(portalSettings.HelplineHours)</p>
                    </div>
                </div>
            </div>

            <!-- Bottom Legal & Copyright -->
            <div class="stitch-footer-bottom">
                <div>
                    &copy; @DateTime.Now.Year <strong>@(portalSettings.BrandName)</strong>. @(portalSettings.FooterCopyrightText)
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="stitch-footer-link">Privacy Policy</a>
                    <a href="/#about" class="stitch-footer-link">Terms of Seva</a>
                    <a href="/#about" class="stitch-footer-link">Authenticity Guarantee</a>
                    <button type="button" onclick="openContactModal()" class="stitch-footer-link">@(portalSettings.AcharyaDeskTitle)</button>
                </div>
            </div>
        </div>
    </footer>

    <!-- ==========================================================================
         INTERACTIVE STITCH MODALS
         ========================================================================== -->

    <!-- 1. PANCHANG MODAL (TODAY'S MUHURAT & SACRED PANCHANG) -->
    <div class="stitch-modal-overlay" id="panchangModal">
        <div class="stitch-modal-card" style="max-width: 680px;">
            <div class="stitch-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-3 font-serif">ॐ</span>
                    <div>
                        <h4 class="mb-0 fw-bold font-serif fs-5">Daily Vedic Panchang &amp; Today's Muhurat</h4>
                        <small class="text-white-50" id="panchangLocationDate">Ramnagar, Jam-khambhalya • @DateTime.Today.ToString("dddd, dd MMMM yyyy")</small>
                    </div>
                </div>
                <button type="button" class="stitch-modal-close" onclick="closePanchangModal()">&times;</button>
            </div>
            <div class="stitch-modal-body">
                <!-- Today's Astrological Strip & Live Muhurat Status -->
                <div class="d-flex flex-wrap align-items-center justify-content-between p-3 rounded-3 mb-3 bg-sacred-low border border-sacred gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-4">🪐</span>
                        <div>
                            <span class="small fw-bold text-saffron text-uppercase d-block" style="font-size: 10px;">Day Lord &amp; Vaara</span>
                            <strong class="text-deep-maroon font-serif" id="panchangDayLord">Thursday (गुरुवार) • Devaguru Brihaspati (Jupiter)</strong>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded-pill bg-white border border-sacred shadow-sm" id="panchangStatusBadgeWrapper">
                            <span class="online-indicator" id="panchangStatusDot" style="width: 8px; height: 8px; background: #22c55e;"></span>
                            <span class="fw-bold small text-success" id="panchangLiveStatus" style="font-size: 11px;">Auspicious Time Active</span>
                        </div>
                        <div class="text-muted-sacred" style="font-size: 10px; margin-top: 2px;">
                            Live Time: <span id="panchangClock" class="fw-semibold text-dark">@DateTime.Now.ToString("hh:mm tt")</span>
                        </div>
                    </div>
                </div>

                <!-- 4 Pillars of Panchanga -->
                <div class="row g-2 text-center mb-3">
                    <div class="col-6 col-md-3">
                        <div class="p-2 p-md-3 rounded-3 bg-sacred-low border-sacred border h-100">
                            <span class="small fw-bold text-saffron text-uppercase d-block" style="font-size: 10px;">Tithi (तिथि)</span>
                            <strong class="font-serif fs-6 text-dark d-block mt-1" id="panchangTithi">Krishna Chaturdashi</strong>
                            <small class="text-muted-sacred" id="panchangTithiSub" style="font-size: 10px;">Upto 09:42 PM</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 p-md-3 rounded-3 bg-sacred-low border-sacred border h-100">
                            <span class="small fw-bold text-saffron text-uppercase d-block" style="font-size: 10px;">Nakshatra (नक्षत्र)</span>
                            <strong class="font-serif fs-6 text-dark d-block mt-1" id="panchangNakshatra">Magha / Purva Phalguni</strong>
                            <small class="text-muted-sacred" id="panchangNakshatraSub" style="font-size: 10px;">Divine Auspicious Star</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 p-md-3 rounded-3 bg-sacred-low border-sacred border h-100">
                            <span class="small fw-bold text-saffron text-uppercase d-block" style="font-size: 10px;">Yoga (योग)</span>
                            <strong class="font-serif fs-6 text-dark d-block mt-1" id="panchangYoga">Sadhya / Shubha Yoga</strong>
                            <small class="text-muted-sacred" id="panchangYogaSub" style="font-size: 10px;">Fruitful for all Rites</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-2 p-md-3 rounded-3 bg-sacred-low border-sacred border h-100">
                            <span class="small fw-bold text-saffron text-uppercase d-block" style="font-size: 10px;">Karana (करण)</span>
                            <strong class="font-serif fs-6 text-dark d-block mt-1" id="panchangKarana">Shakuni / Chatushpada</strong>
                            <small class="text-muted-sacred" id="panchangKaranaSub" style="font-size: 10px;">Universal Peace</small>
                        </div>
                    </div>
                </div>

                <!-- Auspicious Timings -->
                <div class="p-3 rounded-3 mb-3" style="background: #ecfdf5; border: 1px solid #a7f3d0;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-success small text-uppercase">✨ Today's Auspicious Timings (शुभ मुहूर्त)</span>
                        <span class="badge bg-success text-white" style="font-size: 10px;">Highly Recommended</span>
                    </div>
                    <div class="row g-2 small">
                        <div class="col-sm-6">
