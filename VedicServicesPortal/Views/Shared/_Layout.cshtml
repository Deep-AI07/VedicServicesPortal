                        <div class="text-end">
                            <a href="/Service/Index" class="btn-stitch-outline py-1 px-2 small text-decoration-none" style="font-size: 11px;">
                                Choose →
                            </a>
                        </div>
                    </div>`;
            });

            listEl.innerHTML = html;
