                            <li>Havan Samidha woods (Mango, Peepal, Khair)</li>
                            <li>Dhoop, Camphor, Roli, Akshat, Sacred Kalash threads</li>
                            <li>Specific dosha-mitigating herbal blends</li>
                        </ul>
                        <p class="mb-0" style="font-size: 12px;">The Yajman only needs to keep fresh flowers, fruits, and pan-supari ready.</p>`;
                }
                else if (lower.includes("muhurat") || lower.includes("panchang") || lower.includes("tithi") || lower.includes("today")) {
                    const todayName = new Date().toLocaleDateString('en-US', { weekday: 'long' });
                    const todayDayOfWeek = new Date().getDay();
                    const dayObj = (typeof panchangDaysData !== 'undefined') ? (panchangDaysData[todayDayOfWeek] || panchangDaysData[4]) : null;
                    const abhijitVal = dayObj ? dayObj.abhijit : "11:48 AM – 12:38 PM";
                    const amritVal = dayObj ? dayObj.amrit : "06:15 PM – 07:55 PM";
                    const rahuVal = dayObj ? dayObj.rahu : "01:30 PM – 03:00 PM";
                    const lordVal = dayObj ? dayObj.lord : "Devaguru Brihaspati (Jupiter)";

                    answer = `
                        <p class="mb-1"><strong>✨ Today's (${todayName}) Auspicious Muhurat:</strong></p>
                        <p class="mb-2" style="font-size: 12px;"><strong>Day Lord:</strong> ${lordVal}</p>
                        <ul class="mb-2 ps-3" style="font-size: 12px;">
                            <li><strong>🌟 Abhijit Muhurat:</strong> <span class="text-success fw-bold">${abhijitVal}</span> (Supreme victory hour; best for all pujas, havans &amp; sankalp)</li>
                            <li><strong>🍯 Amrit Kaal:</strong> <span class="text-success fw-bold">${amritVal}</span> (Fruitful for new endeavors)</li>
                            <li><strong>🌅 Brahma Muhurat:</strong> 04:35 AM – 05:23 AM (Meditation &amp; morning prayers)</li>
                            <li><strong>⚠️ Today's Rahu Kaal:</strong> <span class="text-danger fw-bold">${rahuVal}</span> (Inauspicious; avoid starting new rituals)</li>
                        </ul>
                        <p class="mb-2" style="font-size: 11px;">📍 Calibrated for <em>Ramnagar, Jam-khambhalya</em>.</p>
                        <button type="button" class="btn-stitch-primary py-1 px-3 small" onclick="openPanchangModal()">
                            ✨ View Full Live Panchang Modal
                        </button>`;
                }
                else if (lower.includes("login") || lower.includes("sign in") || lower.includes("username") || lower.includes("password") || lower.includes("register") || lower.includes("account")) {
                    answer = `
                        <p class="mb-1"><strong>🔐 Sacred Portal Login Guidelines:</strong></p>
                        <ul class="mb-2 ps-3" style="font-size: 12px;">
                            <li><strong>🙏 Devotees:</strong> Sign in using your registered <strong>Username</strong> and <strong>Password</strong>.</li>
                            <li><strong>🛡️ Administrators:</strong> Sign in using your registered <strong>Email Address</strong> and <strong>Password</strong>.</li>
                            <li><strong>🔒 Password Security Requirements:</strong> Must be at least 8 characters, with at least 1 capital letter (A-Z), 1 lowercase letter (a-z), 1 number (0-9), and 1 special symbol (@@$!%*?&#).</li>
                        </ul>
                        <div class="d-flex gap-2">
                            <a href="/Account/Login" class="btn-stitch-primary py-1 px-3 small text-decoration-none">Go to Login</a>
                            <a href="/Account/Register" class="btn-stitch-outline py-1 px-3 small text-decoration-none">Create Account</a>
                        </div>`;
                }
                else {
                    // Responsive Contextual Fallback responding directly according to what was sent
                    answer = `
                        <p class="mb-1"><strong>Namaste! 🙏 Regarding "${escapeHtml(cleanQuery)}":</strong></p>
                        <p class="mb-2" style="font-size: 12px;">I would be honored to assist you with this. For customized rituals, special Havans, or Gotra queries, our senior Acharya at @(portalSettings.ContactAddress) is available directly:</p>
                        <div class="p-2 rounded-2 bg-sacred-low border border-sacred mb-2" style="font-size: 12px;">
                            📍 <strong>Sanctum Office:</strong> @(portalSettings.ContactAddress)<br />
                            📞 <strong>Direct Helpline:</strong> <a href="tel:@(portalSettings.ContactPhone.Replace(" ", "").Replace("-", ""))" class="text-primary-maroon fw-bold">@(portalSettings.ContactPhone)</a><br />
                            ✉️ <strong>Email:</strong> <a href="mailto:@(portalSettings.ContactEmail)" class="text-primary-maroon">@(portalSettings.ContactEmail)</a>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/Service/Index" class="btn-stitch-primary py-1 px-3 small text-decoration-none">View 12 Pujas</a>
                            <button type="button" onclick="openContactModal()" class="btn-stitch-outline py-1 px-3 small">@(portalSettings.AcharyaDeskTitle)</button>
                        </div>`;
                }

                const botNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const botMsgHtml = `
                    <div class="ai-msg bot-msg">
                        <div class="ai-msg-bubble">${answer}</div>
                        <small class="ai-msg-time">${botNow}</small>
                    </div>`;
                container.insertAdjacentHTML('beforeend', botMsgHtml);
                container.scrollTop = container.scrollHeight;
            }, 500);
        }

        function escapeHtml(str) {
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
