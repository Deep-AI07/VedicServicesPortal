        function highlightMatch(text, query) {
            if (!query) return text;
            const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            return text.replace(regex, '<mark style="background:#fef08a; padding: 0 2px; border-radius: 2px; color: #801818; font-weight: bold;">$1</mark>');
        }

        function renderSearchSuggestions(query) {
            const listEl = document.getElementById('searchSuggestionsList');
            const titleEl = document.getElementById('searchSuggestionsTitle');
            const countEl = document.getElementById('searchSuggestionsCount');
            const clearBtn = document.getElementById('quickModalSearchClearBtn');
