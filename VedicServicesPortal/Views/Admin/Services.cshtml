@model IEnumerable<VedicServicesPortal.Models.Service>

@{
    ViewData["Title"] = "Manage Sacred Services";
    var bookingCounts = ViewBag.BookingCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container py-4">

    <!-- BREADCRUMB / BACK LINK -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold mb-2">
                🪔 Sacred Rituals &amp; Pujas Catalog
            </span>
            <h1 class="fw-bold mb-1 display-6" style="font-family: 'Cinzel', serif; color: #3a1c06;">
                Manage Sacred Services
            </h1>
            <p class="text-muted mb-0">
                Add, update, or configure Vedic pujas, havans, sanskars, and ritual offerings.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary px-3 py-2 rounded-pill shadow-sm">
                ← Admin Dashboard
            </a>
            <a asp-controller="Service" asp-action="Index" class="btn btn-outline-primary px-3 py-2 rounded-pill shadow-sm">
                👁️ View Public Catalog
            </a>
            <a asp-controller="Admin" asp-action="CreateService" class="btn btn-vedic-primary px-4 py-2 rounded-pill shadow-sm">
                ✨ + Add New Service
            </a>
        </div>
    </div>

    <!-- ALERTS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert" style="background: #eafaf1; color: #1e7e34;">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">🌺</span>
                <div>
                    <strong>Success!</strong> @TempData["Success"]
                </div>
            </div>
            <button type="button" class="close text-muted" data-dismiss="alert" aria-label="Close" onclick="this.closest('.alert').remove()" style="background: none; border: none; font-size: 1.4rem;">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center justify-content-between" role="alert" style="background: #fdf2f2; color: #9b1c1c;">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">⚠️</span>
                <div>
                    <strong>Action Protected:</strong> @TempData["Error"]
                </div>
            </div>
            <button type="button" class="close text-muted" data-dismiss="alert" aria-label="Close" onclick="this.closest('.alert').remove()" style="background: none; border: none; font-size: 1.4rem;">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- STAT SUMMARY CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #fff9f0 0%, #ffffff 100%); border-left: 5px solid #f39c12 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-semibold small">Total Services</span>
                        <h2 class="fw-bold mb-0 text-dark">@(ViewBag.TotalServices ?? Model?.Count() ?? 0)</h2>
                        <small class="text-muted">Rituals in database</small>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #fff3e0; font-size: 24px;">
                        🪔
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #fffbf4 0%, #ffffff 100%); border-left: 5px solid #28a745 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-semibold small">Active Offerings</span>
                        <h2 class="fw-bold mb-0 text-success">@(ViewBag.ActiveServices ?? 0)</h2>
                        <small class="text-muted">Available for devotees to book</small>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #eafaf1; font-size: 24px;">
                        ✓
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #fdf6f7 0%, #ffffff 100%); border-left: 5px solid #dc3545 !important;">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-semibold small">Inactive Services</span>
                        <h2 class="fw-bold mb-0 text-danger">@(ViewBag.InactiveServices ?? 0)</h2>
                        <small class="text-muted">Hidden from public catalog</small>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: #fee2e2; font-size: 24px;">
                        ⏸️
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SERVICES TABLE CARD -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid #f2e3cf !important;">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color: #3a1c06;">
                📜 Vedic Services Directory
            </h5>
            <span class="badge bg-light text-muted border px-3 py-1 rounded-pill">
                @((Model?.Count() ?? 0)) Services
            </span>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background: #faf6f0; color: #5a381d; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-4 py-3">Sacred Ritual</th>
                                <th class="py-3">Dakshina / Price</th>
                                <th class="py-3">Duration</th>
                                <th class="py-3 text-center">Status</th>
                                <th class="py-3 text-center">Bookings</th>
                                <th class="pe-4 py-3 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var service in Model)
                            {
                                var bCount = bookingCounts.ContainsKey(service.ServiceId) ? bookingCounts[service.ServiceId] : 0;

                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm me-3"
                                                 style="width: 44px; height: 44px; background: #fff3e0; font-size: 22px; border: 1px solid #ffe0b2;">
                                                @if (service.ServiceName.Contains("Havan"))
                                                {
                                                    <span>🔥</span>
                                                }
                                                else if (service.ServiceName.Contains("Jyotish"))
                                                {
                                                    <span>🔮</span>
                                                }
                                                else if (service.ServiceName.Contains("Griha"))
                                                {
                                                    <span>🏠</span>
                                                }
                                                else
                                                {
                                                    <span>🪔</span>
                                                }
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark mb-0">
                                                    @service.ServiceName
                                                </div>
                                                <small class="text-muted d-block" style="font-size: 11px;">Service ID #@service.ServiceId</small>
                                                <small class="text-muted text-truncate d-inline-block" style="max-width: 280px;">
                                                    @service.Description
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <strong class="text-dark">₹@service.Price.ToString("N0")</strong>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                            ⏳ @service.Duration Hour@(service.Duration > 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td class="py-3 text-center">
                                        <form asp-action="ToggleServiceStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@service.ServiceId" />
                                            @if (service.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 py-1" title="Click to Deactivate">
                                                    ✓ Active
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-secondary rounded-pill px-3 py-1" title="Click to Activate">
                                                    ⏸️ Inactive
                                                </button>
                                            }
                                        </form>
                                    </td>
                                    <td class="py-3 text-center">
                                        @if (bCount > 0)
                                        {
                                            <span class="badge bg-light text-dark border px-3 py-1 rounded-pill fw-semibold">
                                                🪔 @bCount Booking@(bCount > 1 ? "s" : "")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="btn-group shadow-sm rounded-pill" role="group">
                                            <a asp-controller="Service" asp-action="Details" asp-route-id="@service.ServiceId" class="btn btn-sm btn-outline-primary px-3" title="View Public Page">
                                                👁️ View
                                            </a>
                                            <a asp-action="EditService" asp-route-id="@service.ServiceId" class="btn btn-sm btn-outline-secondary px-3" title="Edit Service">
                                                ✏️ Edit
                                            </a>
                                            <a asp-action="DeleteService" asp-route-id="@service.ServiceId" class="btn btn-sm btn-outline-danger px-3" title="Remove Service">
                                                🗑️ Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="fs-1 mb-2">🪔</div>
                    <h5 class="text-muted">No services found in database</h5>
                    <a asp-action="CreateService" class="btn btn-vedic-primary mt-3 px-4 py-2 rounded-pill">
                        Add First Service
                    </a>
                </div>
            }
        </div>
    </div>
</div>
