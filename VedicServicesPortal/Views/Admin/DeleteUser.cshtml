@model VedicServicesPortal.Models.User

@{
    ViewData["Title"] = "Remove User";
    var bookingCount = (int)(ViewBag.BookingCount ?? 0);
    var isSelf = (bool)(ViewBag.IsSelf ?? false);
    var canDelete = (!isSelf && bookingCount == 0);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <!-- BREADCRUMB / BACK LINK -->
            <div class="mb-3">
                <a asp-controller="Admin" asp-action="Users" class="text-decoration-none text-muted small fw-semibold">
                    ← Back to Devotees &amp; Users Directory
                </a>
            </div>

            <!-- CARD -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid #f2e3cf !important;">
                
                <div class="card-header text-center py-4 border-bottom" style="background: linear-gradient(135deg, #fff5f5 0%, #fee2e2 100%);">
                    <div class="fs-1 mb-2">🗑️</div>
                    <h3 class="fw-bold mb-1 text-danger" style="font-family: 'Cinzel', serif;">
                        Confirm User Deletion
                    </h3>
                    <p class="text-muted small mb-0">
                        Please review the details below before removing this account from the portal.
                    </p>
                </div>

                <div class="card-body p-4 p-md-5">

                    <!-- USER INFO SUMMARY -->
                    <div class="p-3 rounded-4 mb-4" style="background: #faf7f2; border: 1px solid #eedec7;">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm me-3"
                                 style="width: 50px; height: 50px; background: #fff; color: #b71c1c; border: 2px solid #fca5a5; font-size: 20px;">
                                @(string.IsNullOrEmpty(Model.Name) ? "U" : Model.Name.Substring(0, 1).ToUpper())
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@Model.Name</h5>
                                <span class="text-muted small">Account ID: #@Model.UserId</span>
                            </div>
                        </div>

                        <hr class="my-2" style="border-color: #e5d5be;" />

                        <div class="row g-2 small">
                            <div class="col-sm-4 text-muted">Email:</div>
                            <div class="col-sm-8 fw-semibold text-dark font-monospace">@Model.Email</div>

                            <div class="col-sm-4 text-muted">Role:</div>
                            <div class="col-sm-8">
                                @if (Model.Role == "Admin")
                                {
                                    <span class="badge rounded-pill px-2 py-1" style="background: #fee2e2; color: #991b1b;">
                                        🛡️ Administrator
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2 py-1" style="background: #fef3c7; color: #92400e;">
                                        🙏 Devotee
                                    </span>
                                }
                            </div>

                            <div class="col-sm-4 text-muted">Associated Bookings:</div>
                            <div class="col-sm-8">
                                @if (bookingCount > 0)
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1 rounded-pill fw-semibold">
                                        ⚠️ @bookingCount Booking Record(s) Found
                                    </span>
                                }
                                else
                                {
                                    <span class="text-success fw-semibold">✓ None (Clean to delete)</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- WARNING BLOCKS -->
                    @if (isSelf)
                    {
                        <div class="alert alert-danger rounded-3 d-flex align-items-center mb-4">
                            <span class="fs-4 me-2">🔒</span>
                            <div class="small">
                                <strong>Action Blocked:</strong> You cannot delete your own logged-in administrator account.
                            </div>
                        </div>
                    }
                    else if (bookingCount > 0)
                    {
                        <div class="alert alert-warning rounded-3 d-flex align-items-center mb-4">
                            <span class="fs-4 me-2">⚠️</span>
                            <div class="small">
                                <strong>Database Integrity Guard:</strong> This user cannot be deleted because they have <strong>@bookingCount associated booking(s)</strong>. Please review or cancel those bookings before removing the user.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary rounded-3 d-flex align-items-center mb-4" style="background: #fdf5f5; border-color: #f8d7da; color: #721c24;">
                            <span class="fs-4 me-2">⚠️</span>
                            <div class="small">
                                <strong>Warning:</strong> Are you sure you want to permanently delete user <strong>@Model.Name</strong>? This action cannot be undone.
                            </div>
                        </div>
                    }

                    <!-- FORM -->
                    <form asp-action="DeleteUser" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.UserId" />

                        <div class="d-flex gap-3 pt-2">
                            @if (canDelete)
                            {
                                <button type="submit" class="btn btn-danger flex-grow-1 py-2 rounded-pill fw-semibold shadow-sm">
                                    🗑️ Yes, Delete User
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary flex-grow-1 py-2 rounded-pill fw-semibold opacity-50" disabled>
                                    🔒 Deletion Blocked
                                </button>
                            }
                            <a asp-action="Users" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                                Back to Users
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
