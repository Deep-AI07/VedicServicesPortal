@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4 py-lg-5" style="max-width: 1200px;">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <span class="badge rounded-pill px-3 py-1 bg-sacred-container text-saffron fw-bold small mb-2">
                🪔 Sanatana Administration Hub
            </span>
            <h1 class="fw-bold mb-1 display-5 font-serif text-dark">
                Admin <span class="text-primary-maroon font-serif">Dashboard</span>
            </h1>
            <p class="text-muted-sacred mb-0">
                Complete overview and management of Vedic rituals, priests, muhurats, and devotees.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge rounded-pill px-3 py-2 fw-semibold shadow-sm" style="background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; font-size: 13px;">
                🛡️ Logged in as Administrator
            </span>
        </div>
    </div>

    <!-- ADMIN QUICK NAVIGATION TOOLBAR -->
    <div class="stitch-card mb-5 p-3">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="small fw-bold text-uppercase text-saffron me-2">⚡ Quick Links:</span>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn-stitch-primary px-3 py-1 small">
                📊 Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Users" class="btn-stitch-secondary px-3 py-1 small">
                👥 Devotees &amp; Users
            </a>
            <a asp-controller="Admin" asp-action="Pandits" class="btn-stitch-secondary px-3 py-1 small">
                🧘 Vedic Pandits
            </a>
            <a asp-controller="Admin" asp-action="TimeSlots" class="btn-stitch-secondary px-3 py-1 small">
                🕐 Muhurat Slots
            </a>
            <a asp-controller="Admin" asp-action="Bookings" class="btn-stitch-secondary px-3 py-1 small">
                📋 Ritual Bookings
            </a>
            <a asp-controller="Admin" asp-action="Services" class="btn-stitch-secondary px-3 py-1 small">
                🪔 Sacred Services
            </a>
            <a asp-controller="Admin" asp-action="Settings" class="btn-stitch-secondary px-3 py-1 small fw-bold text-saffron" style="border-color: #dfbfbc !important;">
                ⚙️ Brand &amp; Acharya Desk
            </a>
            <a asp-controller="Account" asp-action="Logout" class="btn-stitch-outline px-3 py-1 small ms-auto">
                Logout
            </a>
        </div>
    </div>

    <!-- 5 CORE METRIC STATS -->
    <h3 class="fs-5 fw-bold mb-3 font-serif text-dark">
        🌟 Portal Overview
    </h3>

    <div class="row g-3 mb-5">
        <!-- USERS -->
        <div class="col-sm-6 col-lg">
            <div class="stitch-card h-100 p-3" style="border-top: 4px solid #cca830 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted-sacred small text-uppercase fw-semibold" style="font-size: 11px;">Total Users</span>
                    <span class="fs-4">👥</span>
                </div>
                <h2 class="display-6 fw-bold mb-0 text-dark font-serif">@ViewBag.TotalUsers</h2>
                <small class="text-muted-sacred">Registered accounts</small>
            </div>
        </div>

        <!-- PANDITS -->
        <div class="col-sm-6 col-lg">
            <div class="stitch-card h-100 p-3" style="border-top: 4px solid #a83900 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted-sacred small text-uppercase fw-semibold" style="font-size: 11px;">Total Pandits</span>
                    <span class="fs-4">🧘</span>
                </div>
                <h2 class="display-6 fw-bold mb-0 text-dark font-serif">@ViewBag.TotalPandits</h2>
                <small class="text-muted-sacred">Certified priests</small>
            </div>
        </div>

        <!-- SERVICES -->
        <div class="col-sm-6 col-lg">
            <div class="stitch-card h-100 p-3" style="border-top: 4px solid #801818 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted-sacred small text-uppercase fw-semibold" style="font-size: 11px;">Total Services</span>
                    <span class="fs-4">🪔</span>
                </div>
                <h2 class="display-6 fw-bold mb-0 text-dark font-serif">@ViewBag.TotalServices</h2>
                <small class="text-muted-sacred">Pujas &amp; havans</small>
            </div>
        </div>

        <!-- TIME SLOTS -->
        <div class="col-sm-6 col-lg">
            <div class="stitch-card h-100 p-3" style="border-top: 4px solid #735c00 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted-sacred small text-uppercase fw-semibold" style="font-size: 11px;">Total Time Slots</span>
                    <span class="fs-4">🕐</span>
                </div>
                <h2 class="display-6 fw-bold mb-0 text-dark font-serif">@ViewBag.TotalTimeSlots</h2>
                <small class="text-muted-sacred">Muhurat windows</small>
            </div>
        </div>

        <!-- BOOKINGS -->
        <div class="col-sm-6 col-lg">
            <div class="stitch-card h-100 p-3" style="border-top: 4px solid #5f0006 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted-sacred small text-uppercase fw-semibold" style="font-size: 11px;">Total Bookings</span>
                    <span class="fs-4">📋</span>
                </div>
                <h2 class="display-6 fw-bold mb-0 text-primary-maroon font-serif">@ViewBag.TotalBookings</h2>
                <small class="text-muted-sacred">Total ritual requests</small>
            </div>
        </div>
    </div>

    <!-- BOOKING STATUS BREAKDOWN -->
    <h3 class="fs-5 fw-bold mb-3 font-serif text-dark">
        📊 Booking Lifecycle Status
    </h3>

    <div class="row g-3 mb-5">
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-sacred-container border border-sacred h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted-sacred small text-uppercase fw-bold" style="font-size: 11px;">⏳ Pending</span>
                        <h3 class="fs-4 fw-bold mb-0 text-dark font-serif">@ViewBag.PendingBookings</h3>
                    </div>
                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small">Awaiting</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-success-subtle border border-success-subtle h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted-sacred small text-uppercase fw-bold" style="font-size: 11px;">✓ Confirmed</span>
                        <h3 class="fs-4 fw-bold mb-0 text-success font-serif">@ViewBag.ConfirmedBookings</h3>
                    </div>
                    <span class="badge bg-success text-white rounded-pill px-2 py-1 small">Scheduled</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-primary-subtle border border-primary-subtle h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted-sacred small text-uppercase fw-bold" style="font-size: 11px;">✔ Completed</span>
                        <h3 class="fs-4 fw-bold mb-0 text-primary font-serif">@ViewBag.CompletedBookings</h3>
                    </div>
                    <span class="badge bg-primary text-white rounded-pill px-2 py-1 small">Fulfilled</span>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-danger-subtle border border-danger-subtle h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted-sacred small text-uppercase fw-bold" style="font-size: 11px;">✕ Cancelled</span>
                        <h3 class="fs-4 fw-bold mb-0 text-danger font-serif">@ViewBag.CancelledBookings</h3>
                    </div>
                    <span class="badge bg-danger text-white rounded-pill px-2 py-1 small">Released</span>
                </div>
            </div>
        </div>
    </div>

    <!-- MANAGEMENT MODULES -->
    <h3 class="fs-5 fw-bold mb-3 font-serif text-dark">
        ⚙️ Portal Administration Modules
    </h3>

    <div class="row g-4 mb-4">
        <!-- USERS -->
        <div class="col-md-6 col-lg-4">
            <div class="stitch-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stitch-pillar-icon" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        👥
                    </div>
                    <span class="badge bg-sacred-container text-saffron px-3 py-1 rounded-pill small">Users</span>
                </div>
                <h4 class="fs-5 fw-bold mb-1 font-serif text-dark">Devotees &amp; Users</h4>
                <p class="text-muted-sacred small mb-4">
                    Add new portal users, manage administrative roles, and securely manage devotee accounts.
                </p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Admin" asp-action="Users" class="btn-stitch-primary flex-grow-1 text-center py-2 small">
                        Manage Users
                    </a>
                    <a asp-controller="Admin" asp-action="CreateUser" class="btn-stitch-secondary px-3 py-2 small" title="Add User">
                        +
                    </a>
                </div>
            </div>
        </div>

        <!-- PANDITS -->
        <div class="col-md-6 col-lg-4">
            <div class="stitch-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stitch-pillar-icon" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        🧘
                    </div>
                    <span class="badge bg-sacred-container text-saffron px-3 py-1 rounded-pill small">Priests</span>
                </div>
                <h4 class="fs-5 fw-bold mb-1 font-serif text-dark">Vedic Priests</h4>
                <p class="text-muted-sacred small mb-4">
                    Register certified pandits, update qualifications, contact details, and toggle availability.
                </p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Admin" asp-action="Pandits" class="btn-stitch-primary flex-grow-1 text-center py-2 small">
                        Manage Pandits
                    </a>
                    <a asp-controller="Admin" asp-action="CreatePandit" class="btn-stitch-secondary px-3 py-2 small" title="Add Pandit">
                        +
                    </a>
                </div>
            </div>
        </div>

        <!-- TIME SLOTS -->
        <div class="col-md-6 col-lg-4">
            <div class="stitch-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stitch-pillar-icon" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        🕐
                    </div>
                    <span class="badge bg-sacred-container text-saffron px-3 py-1 rounded-pill small">Muhurat</span>
                </div>
                <h4 class="fs-5 fw-bold mb-1 font-serif text-dark">Muhurat Time Slots</h4>
                <p class="text-muted-sacred small mb-4">
                    Schedule auspicious dates, ritual timing windows, and manage booking availability.
                </p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Admin" asp-action="TimeSlots" class="btn-stitch-primary flex-grow-1 text-center py-2 small">
                        Manage Slots
                    </a>
                    <a asp-controller="Admin" asp-action="CreateTimeSlot" class="btn-stitch-secondary px-3 py-2 small" title="Add Slot">
                        +
                    </a>
                </div>
            </div>
        </div>

        <!-- BOOKINGS -->
        <div class="col-md-6 col-lg-4">
            <div class="stitch-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stitch-pillar-icon" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        📋
                    </div>
                    <span class="badge bg-sacred-container text-saffron px-3 py-1 rounded-pill small">Bookings</span>
                </div>
                <h4 class="fs-5 fw-bold mb-1 font-serif text-dark">Ritual Bookings</h4>
                <p class="text-muted-sacred small mb-4">
                    Confirm pending bookings, complete rituals, or cancel and release muhurat slots.
                </p>
                <div class="mt-auto">
                    <a asp-controller="Admin" asp-action="Bookings" class="btn-stitch-primary w-100 text-center py-2 small">
                        View All Bookings
                    </a>
                </div>
            </div>
        </div>

        <!-- SERVICES -->
        <div class="col-md-6 col-lg-4">
            <div class="stitch-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stitch-pillar-icon" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        🪔
                    </div>
                    <span class="badge bg-sacred-container text-saffron px-3 py-1 rounded-pill small">Catalog</span>
                </div>
                <h4 class="fs-5 fw-bold mb-1 font-serif text-dark">Sacred Ritual Catalog</h4>
                <p class="text-muted-sacred small mb-4">
                    Configure available havans, pujas, sanskars, duration, and transparent samagri pricing.
                </p>
                <div class="mt-auto d-flex gap-2">
                    <a asp-controller="Admin" asp-action="Services" class="btn-stitch-primary flex-grow-1 text-center py-2 small">
                        Manage Services
                    </a>
                    <a asp-controller="Admin" asp-action="CreateService" class="btn-stitch-secondary px-3 py-2 small" title="Add Service">
                        +
                    </a>
                </div>
            </div>
        </div>

        <!-- TEMPLE SUPPORT -->
        <div class="col-md-6 col-lg-4">
            <div class="stitch-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stitch-pillar-icon" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        ☸️
                    </div>
                    <span class="badge bg-sacred-container text-saffron px-3 py-1 rounded-pill small">Devotee View</span>
                </div>
                <h4 class="fs-5 fw-bold mb-1 font-serif text-dark">Sanatana Traditions</h4>
                <p class="text-muted-sacred small mb-4">
                    All ceremonies strictly adhere to authentic Vedic scriptures and auspicious panchang guidelines.
                </p>
                <div class="mt-auto">
                    <a asp-controller="Home" asp-action="Index" class="btn-stitch-secondary w-100 text-center py-2 small">
                        Visit Home Portal →
                    </a>
                </div>
            </div>
        </div>

        <!-- BRAND & ACHARYA DESK SETTINGS -->
        <div class="col-md-6 col-lg-4">
            <div class="stitch-card p-4 h-100" style="border: 2px solid #dfbfbc !important; background: linear-gradient(135deg, #fffaf6 0%, #ffffff 100%);">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stitch-pillar-icon" style="width: 48px; height: 48px; font-size: 1.3rem;">
                        ⚙️
                    </div>
                    <span class="badge bg-danger text-white px-3 py-1 rounded-pill small">Customization</span>
                </div>
                <h4 class="fs-5 fw-bold mb-1 font-serif text-dark">Brand &amp; Acharya Desk</h4>
                <p class="text-muted-sacred small mb-4">
                    Update portal name, descriptions, Contact Acharya Desk numbers, email, temple address, and hero copy.
                </p>
                <div class="mt-auto">
                    <a asp-controller="Admin" asp-action="Settings" class="btn-stitch-primary w-100 text-center py-2 small fw-bold">
                        ⚙️ Configure Settings
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
