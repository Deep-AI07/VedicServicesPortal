@model VedicServicesPortal.Models.Service

@{
    ViewData["Title"] = "Add New Service";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <!-- BREADCRUMB / BACK LINK -->
            <div class="mb-3">
                <a asp-controller="Admin" asp-action="Services" class="text-decoration-none text-muted small fw-semibold">
                    ← Back to Services Directory
                </a>
            </div>

            <!-- CARD -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid #f2e3cf !important;">
                
                <div class="card-header text-center py-4 border-bottom" style="background: linear-gradient(135deg, #fff9f0 0%, #fff3e0 100%);">
                    <div class="fs-1 mb-2">🪔</div>
                    <h3 class="fw-bold mb-1" style="font-family: 'Cinzel', serif; color: #3a1c06;">
                        Add New Sacred Service
                    </h3>
                    <p class="text-muted small mb-0">
                        Create a new Vedic puja, havan, sanskar, or astrological consultation.
                    </p>
                </div>

                <div class="card-body p-4 p-md-5">

                    <form asp-action="CreateService" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <!-- SERVICE NAME -->
                        <div class="mb-4">
                            <label asp-for="ServiceName" class="form-label fw-bold text-dark">
                                Service / Ritual Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ServiceName" class="form-control py-2" placeholder="e.g. Maha Ganapati Havan" required />
                            <span asp-validation-for="ServiceName" class="text-danger small"></span>
                        </div>

                        <!-- DESCRIPTION -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-dark">
                                Ritual Description &amp; Significance
                            </label>
                            <textarea asp-for="Description" rows="4" class="form-control py-2" placeholder="Explain the spiritual benefits, vidhi, and auspicious samagri included..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <!-- PRICE -->
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-bold text-dark">
                                    Dakshina / Price (₹) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">₹</span>
                                    <input asp-for="Price" type="number" step="1" class="form-control py-2" placeholder="e.g. 3100" required />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <!-- DURATION -->
                            <div class="col-md-6">
                                <label asp-for="Duration" class="form-label fw-bold text-dark">
                                    Duration (Hours) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="Duration" type="number" step="1" min="1" max="24" class="form-control py-2" placeholder="e.g. 2" required />
                                    <span class="input-group-text bg-light">Hours</span>
                                </div>
                                <span asp-validation-for="Duration" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- ACTIVE STATUS -->
                        <div class="mb-4">
                            <div class="form-check form-switch p-0 d-flex align-items-center gap-3">
                                <input asp-for="IsActive" class="form-check-input ms-0 fs-4" type="checkbox" role="switch" checked />
                                <label asp-for="IsActive" class="form-check-label fw-bold text-dark mb-0">
                                    Active (Visible in Devotee Catalog for Booking)
                                </label>
                            </div>
                        </div>

                        <!-- SUBMIT & CANCEL BUTTONS -->
                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn btn-vedic-primary flex-grow-1 py-2 rounded-pill fw-semibold shadow-sm">
                                ✨ Save &amp; Publish Service
                            </button>
                            <a asp-action="Services" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
