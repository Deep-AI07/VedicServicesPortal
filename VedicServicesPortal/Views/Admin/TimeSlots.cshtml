@model IEnumerable<VedicServicesPortal.Models.TimeSlot>

@{
    ViewData["Title"] = "Manage Time Slots";
}

<div class="container mt-5 mb-5">

    <div class="admin-header">
        <div>
            <h1>Manage Time Slots</h1>
            <p>Create and manage Pandit booking slots.</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                ← Dashboard
            </a>
            <a asp-action="CreateTimeSlot" class="btn btn-primary">
                + Add Time Slot
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex justify-content-between align-items-center">
            <span>@TempData["Success"]</span>
            <button type="button" class="close text-muted" data-dismiss="alert" aria-label="Close" onclick="this.closest('.alert').remove()" style="background: none; border: none; font-size: 1.4rem;">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex justify-content-between align-items-center">
            <span>@TempData["Error"]</span>
            <button type="button" class="close text-muted" data-dismiss="alert" aria-label="Close" onclick="this.closest('.alert').remove()" style="background: none; border: none; font-size: 1.4rem;">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-bookings text-center">
            <div class="empty-icon">
                🕐
            </div>
            <h3>No Time Slots Found</h3>
            <p>Create a time slot for a Pandit.</p>
            <a asp-action="CreateTimeSlot" class="btn btn-primary">
                Add Time Slot
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var slot in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="admin-management-card">
                        <div class="management-icon">
                            🕐
                        </div>

                        <h3>@slot.Pandit?.Name</h3>

                        <p>
                            <strong>Date:</strong> @slot.Date.ToString("dd-MM-yyyy")
                        </p>

                        <p>
                            <strong>Time:</strong> @slot.StartTime - @slot.EndTime
                        </p>

                        @if (slot.IsBooked)
                        {
                            <span class="badge bg-danger mb-3">
                                Booked
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success mb-3">
                                Available
                            </span>
                        }

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="EditTimeSlot"
                               asp-route-id="@slot.SlotId"
                               class="btn btn-outline-warning">
                                Edit
                            </a>

                            <a asp-action="DeleteTimeSlot"
                               asp-route-id="@slot.SlotId"
                               class="btn btn-outline-danger">
                                Delete
                            </a>
                        </div>

                        <form asp-action="ToggleTimeSlot"
                              method="post"
                              class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@slot.SlotId" />

                            @if (slot.IsBooked)
                            {
                                <button type="submit" class="btn btn-sm btn-success w-100">
                                    Mark Available
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-danger w-100">
                                    Mark Booked
                                </button>
                            }
                        </form>
                    </div>
                </div>
            }
        </div>
    }

</div>
