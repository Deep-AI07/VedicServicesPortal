@model IEnumerable<VedicServicesPortal.Models.Service>

@{
    ViewData["Title"] = "Sacred Vedic Services Catalog";
    var isAdmin = (Context.Session.GetString("UserRole") == "Admin");
}

<div class="container py-4 py-lg-5" style="max-width: 1200px;">

    <!-- TOP BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 mb-0 small">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted-sacred">
                    Home
                </a>
            </li>
            <li class="breadcrumb-item active text-deep-maroon fw-bold" aria-current="page">
                Sacred Services Catalog
            </li>
        </ol>
    </nav>

    <!-- ADMIN CONTEXT TOOLBAR -->
    @if (isAdmin)
    {
        <div class="alert border-0 shadow-sm rounded-4 p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2"
             style="background: linear-gradient(135deg, #fff3e0 0%, #fee2e2 100%); border-left: 5px solid #801818 !important;">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">🛡️</span>
                <div>
                    <strong class="text-dark">Administrator Mode:</strong>
                    <span class="text-muted-sacred small">You are viewing the devotee-facing services catalog.</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    ← Admin Dashboard
                </a>
                <a asp-controller="Admin" asp-action="Services" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                    ⚙️ Manage Services
                </a>
                <a asp-controller="Admin" asp-action="CreateService" class="btn btn-sm btn-stitch-primary rounded-pill px-3">
                    + Add New Service
                </a>
            </div>
        </div>
    }

    <!-- HEADER HERO BANNER -->
    <div class="text-center py-5 mb-5 rounded-5 position-relative overflow-hidden shadow-xs"
         style="background: linear-gradient(135deg, #fff9f0 0%, #fff1e9 50%, #ffeadc 100%); border: 1px solid #dfbfbc;">
        <div class="mandala-watermark position-absolute w-100 h-100" style="inset: 0; opacity: 0.18; pointer-events: none;"></div>
        <div class="position-relative" style="z-index: 1;">
            <div class="d-inline-flex align-items-center justify-content-center gap-2 mb-2">
                <span class="text-sacred-gold fs-5">✤</span>
                <span class="small fw-bold text-saffron text-uppercase" style="letter-spacing: 1.5px; font-size: 11px;">
                    Sanctified Shastric Ceremonies
                </span>
                <span class="text-sacred-gold fs-5">✤</span>
            </div>
            <h1 class="display-5 fw-bold mb-3 font-serif text-dark">
                Auspicious Vedic Pujas &amp; <span class="text-primary-maroon font-serif">Ceremonies</span>
            </h1>
            <p class="lead text-muted-sacred mx-auto mb-0" style="max-width: 680px; font-size: 1.05rem;">
                Performed strictly according to sacred scriptures with certified Gurukul Pandits, verified Muhurat timing, and 100% consecrated Samagri.
            </p>
        </div>
    </div>

    <!-- SEARCH & FILTER TOOLBAR -->
    <div class="stitch-card p-3 mb-5">
        <div class="row g-3 align-items-center justify-content-between">
            <!-- CATEGORY FILTER PILLS -->
            <div class="col-lg-8">
                <div class="d-flex flex-wrap gap-2" id="catalogCategoryPills">
                    <button class="filter-pill active" data-category="all">
                        🪔 All Rituals (@Model.Count())
                    </button>
                    <button class="filter-pill" data-category="havan">
                        🔥 Havans &amp; Yagnas
                    </button>
                    <button class="filter-pill" data-category="puja">
                        🙏 Pujas &amp; Kathas
                    </button>
                    <button class="filter-pill" data-category="griha">
                        🏠 Griha Pravesh &amp; Sanskar
                    </button>
                    <button class="filter-pill" data-category="jyotish">
                        🔮 Astrological &amp; Dosha
                    </button>
                </div>
            </div>

            <!-- SEARCH INPUT -->
            <div class="col-lg-4 position-relative">
                <div class="input-group">
                    <span class="input-group-text bg-sacred-low border-end-0 border-sacred text-muted">🔍</span>
                    <input type="text" id="catalogSearchInput" class="stitch-form-control border-start-0" placeholder="Search puja name or keyword..." autocomplete="off" />
                    <button type="button" id="catalogClearBtn" class="btn btn-outline-secondary border-start-0 border-sacred d-none text-muted-sacred" title="Clear search">✕</button>
                </div>
                <!-- Dynamic Autocomplete Suggestions Dropdown -->
                <div id="catalogSuggestionsDropdown" class="position-absolute start-0 end-0 bg-white rounded-3 shadow-lg border border-sacred mt-1 p-2 d-none" style="z-index: 1050; max-height: 280px; overflow-y: auto;">
                    <div class="d-flex justify-content-between align-items-center px-2 py-1 mb-1 border-bottom">
                        <span class="small fw-bold text-saffron" style="font-size: 11px;">✨ INSTANT SUGGESTIONS</span>
                        <span class="badge bg-sacred-low text-deep-maroon border border-sacred" id="catalogMatchCount" style="font-size: 10px;">0 Matches</span>
                    </div>
                    <div id="catalogSuggestionsList" class="d-flex flex-column gap-1"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- SERVICES GRID -->
    <div class="row g-4" id="catalogGrid">
        @foreach (var service in Model)
