                    <div class="stitch-card h-100">
                        <div class="p-4 pb-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge rounded-pill px-3 py-1 bg-sacred-container text-saffron fw-bold small">108 Mala Jaap</span>
                                <span class="text-muted-sacred small d-flex align-items-center gap-1">⏳ 5 Hours</span>
                            </div>
                            <div class="stitch-service-img-wrap">
                                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBqMlhZl9RPMREXhVAjuImmi_0Wm3ZGSeL3dqoYw7exvNb3Efc52GUmw4r3WlQP25ua9KuGzewjIhoa_mN4WQZvb_BqwH5Ot1tIi9FFHW7blrOUjETag-q8X_vv2T-k1WuusOH4E-z9kQJCcJzMJU9ztERl1UuSJNM8PvuAU5PdwYOqVn7IpuVGKu779Ve7MXFPp1IZ34JG2KuVA266FzU7Sxw-2Mlrl-6JKd3N2IwUJ7IIotj2NzQZWA"
