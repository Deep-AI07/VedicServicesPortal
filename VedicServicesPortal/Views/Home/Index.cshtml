@inject VedicServicesPortal.Data.ApplicationDbContext DbContext
@{
    var homeSettings = SiteSettingsService.GetSettings();
    ViewData["Title"] = $"Home - {homeSettings.BrandName} | {homeSettings.BrandTagline}";

    // Retrieve active services to bind dynamic IDs and dakshina
    var allActiveServices = DbContext.Services.Where(s => s.IsActive).ToList();
    var ganeshSvc = allActiveServices.FirstOrDefault(s => s.ServiceName.Contains("Ganesh"));
    var satyanarayanSvc = allActiveServices.FirstOrDefault(s => s.ServiceName.Contains("Satyanarayan"));
    var grihaSvc = allActiveServices.FirstOrDefault(s => s.ServiceName.Contains("Griha") || s.ServiceName.Contains("Vastu"));
    var navgrahaSvc = allActiveServices.FirstOrDefault(s => s.ServiceName.Contains("Navgraha"));
    var mahaSvc = allActiveServices.FirstOrDefault(s => s.ServiceName.Contains("Maha Mrityunjaya") || s.ServiceName.Contains("Mrityunjaya"));
    var lakshmiSvc = allActiveServices.FirstOrDefault(s => s.ServiceName.Contains("Lakshmi") || s.ServiceName.Contains("Kuber"));
}

<div class="overflow-hidden position-relative">

    <!-- ==========================================================================
         1. HERO SECTION (STITCH REPLICATION)
         ========================================================================== -->
    <section class="position-relative py-5 py-lg-6 bg-sacred-surface">
        <!-- Ambient sacred glow effects -->
        <div class="ambient-glow-top"></div>
        <div class="ambient-glow-bottom"></div>

        <div class="container position-relative" style="max-width: 1200px; z-index: 1;">
            <div class="row align-items-center g-5">
                <!-- Left Column Content -->
                <div class="col-lg-7">
                    <!-- Eyebrow Pill Badge -->
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4"
                         style="background: #ffeadc; border: 1px solid rgba(223, 191, 188, 0.7);">
                        <span class="text-saffron fs-6">🔥</span>
                        <span class="small fw-bold text-saffron text-uppercase" style="letter-spacing: 1.5px; font-size: 11px;">
                            Traditional Rituals • Modern Booking
                        </span>
                    </div>

                    <!-- Monumental Serif Heading -->
                    <h1 class="display-4 fw-bold text-dark mb-4 font-serif" style="line-height: 1.15; letter-spacing: -0.5px;">
                        @(homeSettings.HeroHeadline) <br class="d-none d-sm-inline" />
                        <span class="text-primary-maroon fst-italic font-serif">@(homeSettings.HeroSubheadline)</span>
                    </h1>

                    <!-- Supporting Narrative -->
                    <p class="lead text-muted-sacred mb-4" style="max-width: 580px; line-height: 1.7; font-size: 1.12rem;">
                        @(homeSettings.HeroDescription)
                    </p>

                    <!-- Action Buttons Lockup -->
                    <div class="d-flex flex-wrap align-items-center gap-3 mb-5">
                        <a asp-controller="Service" asp-action="Index" class="btn-stitch-primary py-3 px-4 fs-6 shadow-lg">
                            <span>Book a Service</span>
                            <span>→</span>
                        </a>
                        <a href="#pandits" class="btn-stitch-secondary py-3 px-4 fs-6">
                            <span>Explore Pandits</span>
                        </a>
                    </div>

                    <!-- Devotee Trust Stat Snippet -->
                    <div class="d-inline-flex flex-wrap align-items-center gap-3 p-3 px-4 rounded-4 bg-white shadow-sm border border-sacred">
                        <div class="d-flex text-sacred-gold fs-6">
                            ★★★★★
                        </div>
                        <div class="d-none d-sm-block bg-sacred border-end" style="height: 18px; width: 1px;"></div>
                        <p class="small text-muted-sacred mb-0">
                            @(homeSettings.TrustStatsText)
                        </p>
                    </div>
                </div>

                <!-- Right Column Ceremony Visual -->
                <div class="col-lg-5 text-center">
                    <div class="position-relative d-inline-block w-100" style="max-width: 480px;">
                        <!-- Glow Aura -->
                        <div class="position-absolute w-100 h-100 rounded-5"
                             style="inset: 0; background: linear-gradient(135deg, rgba(168,57,0,0.15) 0%, rgba(204,168,48,0.18) 50%, rgba(128,24,24,0.15) 100%); filter: blur(28px); transform: scale(1.05);">
                        </div>

                        <!-- Frame container for image -->
                        <div class="position-relative rounded-5 overflow-hidden shadow-2xl border-2 border-sacred bg-sacred-low group" style="border-width: 2px;">
                            <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuB5j70VsQC1ci8vhtpzdpNGd_lvxkMy1DmxLe9YIt1pNq_lM00V1xyTmQcLIEq9eXd2I6-KmP8pTDxcy4McsH5a0kX4r5fLBb0BA7JDMpBorwgyF7npKafdCeQBK8eYJFPsxGvFP7ox_iVT32_Bkj9RIJLxKdfcgjh2vHNZQtPVkMD1UmJ4Daopyu86a1SBP8zBrIzHqnSr7D1n16H6aJzhcfMx_PI-T1E5px8KkzXvqFbClr987840lw"
                                 alt="Devotees offering prayers before sacred fire homa kund"
                                 class="w-100 object-fit-cover hover-elevate"
                                 style="height: 420px; transition: transform 0.6s ease;" />

                            <!-- Floating Auspicious Badge Overlay -->
                            <div class="position-absolute bottom-0 start-0 end-0 m-3 p-3 rounded-4 bg-white-95 backdrop-blur shadow-lg border border-sacred text-start d-flex align-items-center justify-content-between"
                                 style="background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(8px);">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="stitch-pillar-icon" style="width: 42px; height: 42px; font-size: 1.2rem;">
                                        🛡️
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small" style="line-height: 1.2;">100% Authentic Vidhi</div>
                                        <small class="text-muted-sacred" style="font-size: 11px;">Vedic Mantras &amp; Pure Samagri</small>
                                    </div>
                                </div>
                                <span class="font-serif fst-italic fw-bold text-saffron fs-5">Blessings</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================================================
         2. TRUST PILLARS (STITCH REPLICATION)
         ========================================================================== -->
    <section class="py-5 bg-sacred-low border-top border-bottom border-sacred">
        <div class="container" style="max-width: 1200px;">
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="stitch-pillar-card h-100">
                        <div class="stitch-pillar-icon">🛡️</div>
                        <div>
                            <h3 class="fs-6 fw-bold text-dark mb-1">Verified Pandits</h3>
                            <p class="small text-muted-sacred mb-0">Experienced &amp; trusted Vedic scholars from traditional Gurukuls.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="stitch-pillar-card h-100">
                        <div class="stitch-pillar-icon">✨</div>
                        <div>
                            <h3 class="fs-6 fw-bold text-dark mb-1">Authentic Rituals</h3>
                            <p class="small text-muted-sacred mb-0">Pure Shastric vidhi, sacred mantras &amp; 100% consecrated Samagri.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="stitch-pillar-card h-100">
                        <div class="stitch-pillar-icon">📅</div>
                        <div>
                            <h3 class="fs-6 fw-bold text-dark mb-1">Easy Booking</h3>
                            <p class="small text-muted-sacred mb-0">Select customized ceremony, Pandit &amp; auspicious Muhurat slot.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="stitch-pillar-card h-100">
                        <div class="stitch-pillar-icon">🙏</div>
                        <div>
                            <h3 class="fs-6 fw-bold text-dark mb-1">@(homeSettings.AcharyaDeskTitle)</h3>
                            <p class="small text-muted-sacred mb-0">@(homeSettings.AcharyaDeskSubtitle)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================================================
         3. SERVICES SECTION (STITCH REPLICATION)
         ========================================================================== -->
    <section class="py-6 py-lg-7 bg-sacred-surface" id="services">
        <div class="container" style="max-width: 1200px;">
            <!-- Header with Sacred Ornament -->
            <div class="text-center max-w-2xl mx-auto mb-5">
                <div class="d-inline-flex align-items-center justify-content-center gap-2 mb-2">
                    <span class="text-sacred-gold fs-5">✤</span>
                    <span class="small fw-bold text-saffron text-uppercase" style="letter-spacing: 1.5px; font-size: 11px;">Explore Our</span>
                    <span class="text-sacred-gold fs-5">✤</span>
                </div>
                <h2 class="display-5 fw-bold text-dark mb-3 font-serif">
                    Vedic Ritual <span class="text-primary-maroon font-serif">Services</span>
                </h2>
                <p class="lead text-muted-sacred mx-auto mb-4" style="max-width: 650px; font-size: 1.05rem;">
                    Traditional ceremonies performed with devotion, care and shastra authenticity at your residence, workplace or online.
                </p>

                <!-- Quick Filter Category Tabs -->
                <div class="d-flex flex-wrap justify-content-center gap-2" id="homeServicePills">
                    <button type="button" class="filter-pill active" onclick="filterHomeServices('all', this)">All Rituals</button>
                    <button type="button" class="filter-pill" onclick="filterHomeServices('popular', this)">Most Popular</button>
                    <button type="button" class="filter-pill" onclick="filterHomeServices('prosperity', this)">Prosperity &amp; Wealth</button>
                    <button type="button" class="filter-pill" onclick="filterHomeServices('vastu', this)">Griha &amp; Vastu</button>
                    <button type="button" class="filter-pill" onclick="filterHomeServices('health', this)">Health &amp; Longevity</button>
                    <button type="button" class="filter-pill" onclick="filterHomeServices('graha', this)">Navgraha Shanti</button>
                </div>
            </div>

            <!-- Dynamic Grid of 6 Featured Services -->
            <div class="row g-4" id="homeServicesGrid">
                <!-- 1. Ganesh Puja -->
                <div class="col-md-6 col-lg-4 home-service-card" data-cat="popular">
                    <div class="stitch-card h-100">
                        <div class="p-4 pb-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge rounded-pill px-3 py-1 bg-sacred-container text-saffron fw-bold small">Most Popular</span>
                                <span class="text-muted-sacred small d-flex align-items-center gap-1">⏳ 2 Hours</span>
                            </div>
                            <div class="stitch-service-img-wrap">
                                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDwALmFlRgrVSUEi9SZA_FNJe5VouYEenV6tmjR7WvgKjepf6QVw4E32F9v_zziTXySzK-CKBcK3UDSJXdFzrbQG82TLcGr10nBEKE9HEOladK2ALf6ALbQxLgpJVpFBRYQ3BT5nIPniovonycOptphP-F2Edip2PHwDLj1nsT5PnXN-h1O0vInqJHoy4HtWWMYImReZ-mrjFOQfW7LT17oaLRDhskl1nUSoYNOJateLMv6DyrnrPdDuw"
                                     alt="Ganesh Puja" class="stitch-service-img" />
                            </div>
                            <h3 class="fs-5 fw-bold text-dark text-center mb-2 font-serif">Ganesh Puja &amp; Havan</h3>
                            <p class="small text-muted-sacred text-center mb-3" style="min-height: 42px;">
                                Removes obstacles and brings prosperity for all new beginnings and residential peace.
                            </p>
                        </div>
                        <div class="px-4 py-3 bg-sacred-low border-top border-sacred small text-muted-sacred">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Sankalp &amp; Gauri Ganesh Sthapana</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Modak Bhog &amp; 108 Ashtottara Namavali</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Full Puja Samagri Included</span>
                            </div>
                        </div>
                        <div class="p-4 mt-auto d-flex align-items-center justify-content-between border-top border-sacred bg-white">
                            <div>
                                <small class="text-muted-sacred d-block fw-semibold" style="font-size: 11px;">Dakshina</small>
                                <strong class="fs-5 text-primary-maroon font-serif">₹@(ganeshSvc != null ? ganeshSvc.Price.ToString("N0") : "1,500")</strong>
                            </div>
                            <a asp-controller="Booking" asp-action="Create" asp-route-serviceId="@(ganeshSvc?.ServiceId ?? 1)" class="btn-stitch-outline py-2 px-4 small">
                                <span>Book Now</span>
                                <span>→</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 2. Satyanarayan Katha -->
                <div class="col-md-6 col-lg-4 home-service-card" data-cat="prosperity">
                    <div class="stitch-card h-100">
                        <div class="p-4 pb-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge rounded-pill px-3 py-1 bg-sacred-container text-saffron fw-bold small">Divine Bliss</span>
                                <span class="text-muted-sacred small d-flex align-items-center gap-1">⏳ 3.5 Hours</span>
                            </div>
                            <div class="stitch-service-img-wrap">
                                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCF6PJIEfd8R5pKFrkUmBA-pAu4RDvOxUQaj4o6_smwSNRFxG8SFBUNjhN2Cn3XAOtzI8ij142h23kwmQ5_TpDLoWk9hlrbgBoIazNMr6excoB7SoVwfY3t4O24JCoykXPKpq7660tm3OJg9ZDqOQJu6MzCbFsDii-0fZ_aG81RPC6dFhfe7IR6Hl5lUJsXa2VxwvXEu_nm4G5aRO8pisp9A2vqWBXqg61LYI5Tf_whPO3KbT8UwTcAAw"
                                     alt="Satyanarayan Katha" class="stitch-service-img" />
                            </div>
                            <h3 class="fs-5 fw-bold text-dark text-center mb-2 font-serif">Satyanarayan Katha</h3>
                            <p class="small text-muted-sacred text-center mb-3" style="min-height: 42px;">
                                Sacred Vishnu blessings invoking family harmony, holistic prosperity, and eternal gratitude.
                            </p>
                        </div>
                        <div class="px-4 py-3 bg-sacred-low border-top border-sacred small text-muted-sacred">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>5 Adhyay Katha Recitation &amp; Havan</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Panchamrit &amp; Sheera Prasad Vidhi</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Complete Vedic Pandit Chanting</span>
                            </div>
                        </div>
                        <div class="p-4 mt-auto d-flex align-items-center justify-content-between border-top border-sacred bg-white">
                            <div>
                                <small class="text-muted-sacred d-block fw-semibold" style="font-size: 11px;">Dakshina</small>
                                <strong class="fs-5 text-primary-maroon font-serif">₹@(satyanarayanSvc != null ? satyanarayanSvc.Price.ToString("N0") : "2,500")</strong>
                            </div>
                            <a asp-controller="Booking" asp-action="Create" asp-route-serviceId="@(satyanarayanSvc?.ServiceId ?? 2)" class="btn-stitch-outline py-2 px-4 small">
                                <span>Book Now</span>
                                <span>→</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 3. Griha Pravesh -->
                <div class="col-md-6 col-lg-4 home-service-card" data-cat="vastu">
                    <div class="stitch-card h-100">
                        <div class="p-4 pb-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge rounded-pill px-3 py-1 bg-sacred-container text-saffron fw-bold small">Homa Included</span>
                                <span class="text-muted-sacred small d-flex align-items-center gap-1">⏳ 4 Hours</span>
                            </div>
                            <div class="stitch-service-img-wrap">
                                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuClr5ttSw-IDZsFC2OogJUa-b0cPnQCMUWFH9fhnPAgaKtq1wiGToC-G7t_PE2s5JzDbvONQjEVGsvsxXaGy7pwy56lMVJ-EA8ysrwkmP84iAhaUOT4fNUw6TmCnYHi9voEuR9ip38dYoKTTuQ4QDGPkyxwkI-udRyAHoNXFuBdBOUoOI807RqgVmrfASD_0heIVn4CeF_4PPnH2JpO5oJEe_dounaDbnimYRKeqa6jQzJfHr8oNZEoCw"
                                     alt="Griha Pravesh" class="stitch-service-img" />
                            </div>
                            <h3 class="fs-5 fw-bold text-dark text-center mb-2 font-serif">Griha Pravesh &amp; Vastu</h3>
                            <p class="small text-muted-sacred text-center mb-3" style="min-height: 42px;">
                                Sacred Vastu purification and housewarming ritual to dispel negativity and invite Lakshmi into a new home.
                            </p>
                        </div>
                        <div class="px-4 py-3 bg-sacred-low border-top border-sacred small text-muted-sacred">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Vastu Shanti Homa &amp; Navagraha Havan</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Dwar Puja &amp; Kamadhenu Pujan</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Boiling Milk Ceremony Guidance</span>
                            </div>
                        </div>
                        <div class="p-4 mt-auto d-flex align-items-center justify-content-between border-top border-sacred bg-white">
                            <div>
                                <small class="text-muted-sacred d-block fw-semibold" style="font-size: 11px;">Dakshina</small>
                                <strong class="fs-5 text-primary-maroon font-serif">₹@(grihaSvc != null ? grihaSvc.Price.ToString("N0") : "3,500")</strong>
                            </div>
                            <a asp-controller="Booking" asp-action="Create" asp-route-serviceId="@(grihaSvc?.ServiceId ?? 3)" class="btn-stitch-outline py-2 px-4 small">
                                <span>Book Now</span>
                                <span>→</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 4. Navgraha Puja -->
                <div class="col-md-6 col-lg-4 home-service-card" data-cat="graha">
                    <div class="stitch-card h-100">
                        <div class="p-4 pb-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge rounded-pill px-3 py-1 bg-sacred-container text-saffron fw-bold small">Astrology Aligned</span>
                                <span class="text-muted-sacred small d-flex align-items-center gap-1">⏳ 3 Hours</span>
                            </div>
                            <div class="stitch-service-img-wrap">
                                <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCgJbXqn1c0riIeGD9r5gti3ZkddfzfcYM6XLtckcCYKnbHkIxzEpOlfSzKflfZ0R9wwIHYp0_CILX49apqkCRJWmKZIBPExDMVeKHeiq7zWvQvuREERuqQ3TA0veIbsUqsoTGbEeF8di4WSZ123Zqmeg7bhKPWDE7GNI0BbSbSD6USjqAj7f59cwtjCpgH3vKdE2KJ8KeMMPofBvlBdiE1SQApizZ0cCEbKvj_-0xs27Vo3-AdGswOCQ"
                                     alt="Navgraha Puja" class="stitch-service-img" />
                            </div>
                            <h3 class="fs-5 fw-bold text-dark text-center mb-2 font-serif">Navgraha Shanti Puja</h3>
                            <p class="small text-muted-sacred text-center mb-3" style="min-height: 42px;">
                                Harmonize the nine celestial planetary deities, nullifying astrological doshas and restoring cosmic balance.
                            </p>
                        </div>
                        <div class="px-4 py-3 bg-sacred-low border-top border-sacred small text-muted-sacred">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>9 Graha Mantra Japa &amp; Ahutis</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Specialized Samidha Woods &amp; Grains</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-saffron fw-bold">✓</span>
                                <span>Kundali Based Individual Sankalp</span>
                            </div>
                        </div>
                        <div class="p-4 mt-auto d-flex align-items-center justify-content-between border-top border-sacred bg-white">
                            <div>
                                <small class="text-muted-sacred d-block fw-semibold" style="font-size: 11px;">Dakshina</small>
                                <strong class="fs-5 text-primary-maroon font-serif">₹@(navgrahaSvc != null ? navgrahaSvc.Price.ToString("N0") : "3,000")</strong>
                            </div>
                            <a asp-controller="Booking" asp-action="Create" asp-route-serviceId="@(navgrahaSvc?.ServiceId ?? 4)" class="btn-stitch-outline py-2 px-4 small">
                                <span>Book Now</span>
                                <span>→</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 5. Maha Mrityunjaya -->
