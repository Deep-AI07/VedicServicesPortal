@section Scripts {
    <script>
        // Home Services Filter
        function filterHomeServices(category, btn) {
            document.querySelectorAll('#homeServicePills .filter-pill').forEach(el => el.classList.remove('active'));
            btn.classList.add('active');

            const cards = document.querySelectorAll('.home-service-card');
            cards.forEach(card => {
                const cardCat = card.getAttribute('data-cat');
                if (category === 'all' || cardCat === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Home Pandits Filter
        function filterPandits(category, btn) {
            document.querySelectorAll('#panditFilterPills .filter-pill').forEach(el => el.classList.remove('active'));
            btn.classList.add('active');

            const items = document.querySelectorAll('.pandit-card-item');
            items.forEach(item => {
                const itemCat = item.getAttribute('data-category');
                if (category === 'all' || itemCat === category) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Pandit Details Modal
        function openPanditDetailsModal(name, gurukul, exp, lang, pujas, veda, spec, loc, img) {
            document.getElementById('modalPanditName').innerText = name;
            document.getElementById('modalPanditGurukul').innerText = gurukul;
            document.getElementById('modalPanditExp').innerText = exp + ' Sadhana';
            document.getElementById('modalPanditLang').innerText = lang;
            document.getElementById('modalPanditPujas').innerText = pujas + ' Done';
            document.getElementById('modalPanditVeda').innerText = veda;
            document.getElementById('modalPanditSpec').innerText = spec;
            document.getElementById('modalPanditLocation').innerText = '📍 ' + loc;
            document.getElementById('modalPanditImg').src = img;
            document.getElementById('panditProfileModal').classList.add('active');
        }

        function closePanditDetailsModal() {
            document.getElementById('panditProfileModal').classList.remove('active');
        }
    </script>
}
