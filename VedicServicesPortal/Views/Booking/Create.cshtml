            background: rgba(46, 14, 16, 0.65);
            backdrop-filter: blur(8px);
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.25s ease;
            padding: 1rem;
        }

        .stitch-modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .stitch-modal-card {
            background: #ffffff;
            border: 1px solid #dfbfbc;
            border-radius: 1.5rem;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            transform: scale(0.95);
            transition: transform 0.25s ease;
        }

        .stitch-modal-overlay.active .stitch-modal-card {
            transform: scale(1);
        }

        .stitch-modal-close {
            position: absolute;
            top: 1rem;
            right: 1.25rem;
            background: none;
            border: none;
            font-size: 1.75rem;
            color: #801818;
            cursor: pointer;
            line-height: 1;
        }
    </style>

    <script>
        // Switch between Universal Camera-scannable QR and In-App Scanner QR
        function switchQrMode(mode) {
            const qrImg = document.getElementById("checkoutQrImg");
            const modalQrImg = document.getElementById("modalQrImg");
            const btnCamera = document.getElementById("btnModeCamera");
            const btnInApp = document.getElementById("btnModeInApp");
            const btnModalCamera = document.getElementById("btnModalModeCamera");
            const btnModalInApp = document.getElementById("btnModalModeInApp");
            const notice = document.getElementById("qrModeNotice");
            const liveBadge = document.getElementById("checkoutQrLiveBadge");

            if (mode === 'camera') {
                const camSrc = qrImg?.getAttribute("data-camera-src");
                if (qrImg && camSrc) qrImg.src = camSrc;
                if (modalQrImg && camSrc) modalQrImg.src = camSrc;

                [btnCamera, btnModalCamera].forEach(b => { if (b) { b.style.background = "#801818"; b.style.color = "#ffffff"; } });
                [btnInApp, btnModalInApp].forEach(b => { if (b) { b.style.background = "transparent"; b.style.color = "#212529"; } });

                if (notice) notice.innerHTML = "Point your <strong>Mobile Camera</strong> → Tap link → Select your UPI app (GPay, PhonePe, Paytm)";
                if (liveBadge) liveBadge.textContent = "● CAMERA READY";
            } else {
                const inAppSrc = qrImg?.getAttribute("data-inapp-src");
                if (qrImg && inAppSrc) qrImg.src = inAppSrc;
                if (modalQrImg && inAppSrc) modalQrImg.src = inAppSrc;

                [btnInApp, btnModalInApp].forEach(b => { if (b) { b.style.background = "#801818"; b.style.color = "#ffffff"; } });
                [btnCamera, btnModalCamera].forEach(b => { if (b) { b.style.background = "transparent"; b.style.color = "#212529"; } });

                if (notice) notice.innerHTML = "Open <strong>Google Pay / PhonePe</strong> → Scan using in-app scanner";
                if (liveBadge) liveBadge.textContent = "● IN-APP READY";
            }
        }

        // Payment Method Selection Handler
        function selectPaymentMethod(method) {
            document.getElementById('selectedPaymentMethod').value = method;

            // Update card active classes
            document.querySelectorAll('.payment-method-card').forEach(card => card.classList.remove('active'));
            if (method === 'UPI') document.getElementById('optUpi').classList.add('active');
            if (method === 'Card') document.getElementById('optCard').classList.add('active');
            if (method === 'Cash on Completion') document.getElementById('optCash').classList.add('active');

            // Toggle visibility of detail boxes
            document.getElementById('boxUpi').classList.add('d-none');
            document.getElementById('boxCard').classList.add('d-none');
            document.getElementById('boxCash').classList.add('d-none');

            if (method === 'UPI') {
                document.getElementById('boxUpi').classList.remove('d-none');
                document.getElementById('sidebarPaymentBadge').innerText = 'UPI with QR';
                document.getElementById('btnSubmitText').innerText = 'Proceed to Pay via UPI QR (₹@Model.Service.Price.ToString("N0"))';
            } else if (method === 'Card') {
                document.getElementById('boxCard').classList.remove('d-none');
                document.getElementById('sidebarPaymentBadge').innerText = 'Debit / Credit Card';
                document.getElementById('btnSubmitText').innerText = 'Proceed to Pay by Card (₹@Model.Service.Price.ToString("N0"))';
            } else if (method === 'Cash on Completion') {
                document.getElementById('boxCash').classList.remove('d-none');
                document.getElementById('sidebarPaymentBadge').innerText = 'Cash on Completion';
                document.getElementById('btnSubmitText').innerText = 'Confirm Booking (Cash on Completion - ₹@Model.Service.Price.ToString("N0"))';
            }
        }

        // Copy UPI ID helper
        function copyUpiId() {
            const upiId = document.getElementById('portalUpiIdText').innerText.trim();
            navigator.clipboard.writeText(upiId).then(() => {
                alert("✓ VPA ID '" + upiId + "' copied to clipboard!");
            });
        }

        // Auto-fill Test Samples
        function autoFillTestUpi() {
            const sample = "4239" + Math.floor(10000000 + Math.random() * 90000000);
            document.getElementById('inputUpiId').value = sample;
        }

        function autoFillModalUtr() {
            const sample = "4239" + Math.floor(10000000 + Math.random() * 90000000);
            document.getElementById('modalUtrInput').value = sample;
            document.getElementById('modalUtrError').classList.add('d-none');
        }

        function autoFillTestCard() {
            document.getElementById('inputCardHolder').value = "Devotee Yajman";
            document.getElementById('inputCardNumber').value = "4532 8901 2345 6789";
            document.getElementById('inputCardExpiry').value = "12/28";
            document.getElementById('inputCardCvv').value = "789";
            document.getElementById('cardTypeBadge').innerText = "💳 Visa";
            clearCardErrors();
        }

        function autoFillTestOtp() {
            document.getElementById('bankOtpInput').value = "123456";
            document.getElementById('modalOtpError').classList.add('d-none');
        }

        // Card Input Formatting
        function formatCardNumber(input) {
            let value = input.value.replace(/\D/g, '').substring(0, 16);
            let formatted = value.match(/.{1,4}/g)?.join(' ') || value;
            input.value = formatted;

            const badge = document.getElementById('cardTypeBadge');
            if (value.startsWith('4')) badge.innerText = "💳 Visa";
            else if (value.startsWith('5')) badge.innerText = "💳 Mastercard";
            else if (value.startsWith('6')) badge.innerText = "💳 RuPay";
            else badge.innerText = "💳";
        }

        function formatCardExpiry(input) {
            let value = input.value.replace(/\D/g, '').substring(0, 4);
            if (value.length >= 2) {
                input.value = value.substring(0, 2) + ' / ' + value.substring(2);
            } else {
                input.value = value;
            }
        }

        function clearCardErrors() {
            document.getElementById('errCardHolder').classList.add('d-none');
            document.getElementById('errCardNumber').classList.add('d-none');
            document.getElementById('errCardExpiry').classList.add('d-none');
            document.getElementById('errCardCvv').classList.add('d-none');
        }

        // ============================================
        // PAYMENT INITIATION & MODAL CONTROLS
        // ============================================
        let upiTimerInterval = null;

        function handlePaymentInitiation(e) {
            if (e) e.preventDefault();

            // Validate common required fields first
            const panditId = document.getElementById("PanditId").value;
            if (!panditId) {
                alert("Please select a Gurukul Pandit for your ceremony (Step 2).");
                document.getElementById("PanditId").focus();
                return;
            }

            const address = document.getElementById("Address").value.trim();
            if (!address) {
                alert("Please enter the ceremony address / venue (Step 4).");
                document.getElementById("Address").focus();
                return;
            }

            const selectedMethod = document.getElementById("selectedPaymentMethod").value;

            if (selectedMethod === "UPI") {
                openUpiModal();
            } else if (selectedMethod === "Card") {
                // Validate card fields
                clearCardErrors();
                let hasError = false;

                const holder = document.getElementById("inputCardHolder").value.trim();
                if (!holder) {
                    document.getElementById("errCardHolder").classList.remove('d-none');
                    hasError = true;
                }

                const cardNum = document.getElementById("inputCardNumber").value.replace(/\s+/g, '');
                if (cardNum.length < 16) {
                    document.getElementById("errCardNumber").classList.remove('d-none');
                    hasError = true;
                }

                const expiry = document.getElementById("inputCardExpiry").value.replace(/\s+/g, '');
                if (expiry.length < 4) {
                    document.getElementById("errCardExpiry").classList.remove('d-none');
                    hasError = true;
                }

                const cvv = document.getElementById("inputCardCvv").value.trim();
                if (cvv.length < 3) {
                    document.getElementById("errCardCvv").classList.remove('d-none');
                    hasError = true;
                }

                if (hasError) return;

                openCardModal(cardNum);
            } else if (selectedMethod === "Cash on Completion") {
                const chk = document.getElementById("chkCashConsent");
                if (chk && !chk.checked) {
                    alert("Please confirm the Cash on Completion dakshina agreement checkbox.");
                    chk.focus();
                    return;
                }
                openCashModal();
            }
        }

        // UPI Modal Functions
        function openUpiModal() {
            const formUpiVal = document.getElementById("inputUpiId").value.trim();
            const modalUtr = document.getElementById("modalUtrInput");
            if (formUpiVal) {
                modalUtr.value = formUpiVal;
            } else if (!modalUtr.value) {
                modalUtr.value = "4239" + Math.floor(10000000 + Math.random() * 90000000);
            }

            document.getElementById("modalUtrError").classList.add('d-none');
            document.getElementById("upiProcessStatus").classList.add('d-none');
            document.getElementById("btnConfirmUpi").disabled = false;
            document.getElementById("btnCancelUpi").disabled = false;

            document.getElementById("upiPaymentModal").classList.add('active');

            // Start 5-min timer
            startUpiCountdown(300);
        }

        function closeUpiModal() {
            document.getElementById("upiPaymentModal").classList.remove('active');
            if (upiTimerInterval) clearInterval(upiTimerInterval);
        }

        function startUpiCountdown(seconds) {
            if (upiTimerInterval) clearInterval(upiTimerInterval);
            let time = seconds;
            const timerEl = document.getElementById("upiCountdownTimer");
            upiTimerInterval = setInterval(() => {
                const mins = Math.floor(time / 60);
                const secs = time % 60;
                if (timerEl) {
                    timerEl.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
                }
                if (time <= 0) {
                    clearInterval(upiTimerInterval);
                    if (timerEl) timerEl.textContent = "Expired";
                }
                time--;
            }, 1000);
        }

        function processUpiVerification() {
            const utrVal = document.getElementById("modalUtrInput").value.trim();
            if (!utrVal || utrVal.length < 6) {
                document.getElementById("modalUtrError").classList.remove('d-none');
                return;
            }
            document.getElementById("modalUtrError").classList.add('d-none');

            const statusEl = document.getElementById("upiProcessStatus");
            statusEl.className = "p-3 rounded-3 mb-3 bg-light border border-sacred";
            statusEl.innerHTML = `
                <div class="d-flex align-items-center justify-content-center gap-2 text-deep-maroon fw-bold small">
                    <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                    <span>Querying UPI Gateway & Consecrating Dakshina...</span>
                </div>
            `;
            statusEl.classList.remove('d-none');

            document.getElementById("btnConfirmUpi").disabled = true;
            document.getElementById("btnCancelUpi").disabled = true;

            setTimeout(() => {
                const txnId = "VEDA-UPI-" + Date.now().toString().slice(-8);
                statusEl.className = "p-3 rounded-3 mb-3 bg-success-subtle border border-success-subtle text-success";
                statusEl.innerHTML = `
                    <div class="fw-bold mb-1">✓ Dakshina Payment Verified Successfully!</div>
                    <div class="small text-dark font-monospace">Ref ID: #${txnId}</div>
                    <div class="small text-muted mt-1">Registering Order & Generating Sacred Invoice...</div>
                `;

                document.getElementById('IsPaymentCompleted').value = 'true';
                document.getElementById('TransactionId').value = txnId;
                document.getElementById('inputUpiId').value = utrVal;

                setTimeout(() => {
                    document.getElementById('bookingCreateForm').submit();
                }, 800);
            }, 1400);
        }

        // Card Modal Functions
        function openCardModal(cardNum) {
            const last4 = cardNum.slice(-4);
            document.getElementById("otpCardDigits").innerText = `•••• •••• •••• ${last4}`;
            document.getElementById("bankOtpInput").value = "";
            document.getElementById("modalOtpError").classList.add('d-none');
            document.getElementById("cardProcessStatus").classList.add('d-none');
            document.getElementById("btnAuthorizeCard").disabled = false;
            document.getElementById("btnCancelCard").disabled = false;

            document.getElementById("cardOtpModal").classList.add('active');
        }

        function closeCardModal() {
            document.getElementById("cardOtpModal").classList.remove('active');
        }

        function processCardAuthorization() {
            const otpVal = document.getElementById("bankOtpInput").value.trim();
            if (!otpVal || otpVal.length < 4) {
                document.getElementById("modalOtpError").classList.remove('d-none');
                return;
            }
            document.getElementById("modalOtpError").classList.add('d-none');

            const statusEl = document.getElementById("cardProcessStatus");
            statusEl.className = "p-3 rounded-3 mb-3 bg-light border border-sacred";
            statusEl.innerHTML = `
                <div class="d-flex align-items-center justify-content-center gap-2 text-deep-maroon fw-bold small">
                    <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                    <span>Authorizing ₹@Model.Service.Price.ToString("N0") with Card Gateway...</span>
                </div>
            `;
            statusEl.classList.remove('d-none');

            document.getElementById("btnAuthorizeCard").disabled = true;
            document.getElementById("btnCancelCard").disabled = true;

            setTimeout(() => {
                const txnId = "VEDA-CARD-" + Date.now().toString().slice(-8);
                statusEl.className = "p-3 rounded-3 mb-3 bg-success-subtle border border-success-subtle text-success";
                statusEl.innerHTML = `
                    <div class="fw-bold mb-1">✓ Card Payment Authorized Successfully!</div>
                    <div class="small text-dark font-monospace">Auth Code: #${txnId}</div>
                    <div class="small text-muted mt-1">Registering Order & Generating Sacred Invoice...</div>
                `;

                document.getElementById('IsPaymentCompleted').value = 'true';
                document.getElementById('TransactionId').value = txnId;

                setTimeout(() => {
                    document.getElementById('bookingCreateForm').submit();
                }, 800);
            }, 1400);
        }

        // Cash on Completion Modal Functions
        function openCashModal() {
            const dateText = document.getElementById("sidebarDateBadge")?.innerText || "Tomorrow";
            const timeText = document.getElementById("sidebarTimeBadge")?.innerText || "";
            const muhuratEl = document.getElementById("cashModalMuhurat");
            if (muhuratEl) {
                muhuratEl.innerText = `${dateText} (${timeText})`;
            }

            document.getElementById("cashProcessStatus").classList.add('d-none');
            document.getElementById("btnConfirmCash").disabled = false;
            document.getElementById("btnCancelCash").disabled = false;

            document.getElementById("cashConfirmModal").classList.add('active');
        }

        function closeCashModal() {
            document.getElementById("cashConfirmModal").classList.remove('active');
        }

        function processCashBooking() {
            const statusEl = document.getElementById("cashProcessStatus");
            statusEl.className = "p-3 rounded-3 mb-3 bg-light border border-sacred";
            statusEl.innerHTML = `
                <div class="d-flex align-items-center justify-content-center gap-2 text-deep-maroon fw-bold small">
                    <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
                    <span>Registering Order &amp; Consecrating Auspicious Muhurat...</span>
                </div>
            `;
            statusEl.classList.remove('d-none');

            document.getElementById("btnConfirmCash").disabled = true;
            document.getElementById("btnCancelCash").disabled = true;

            setTimeout(() => {
                const txnId = "VEDA-COD-" + Date.now().toString().slice(-8);
                statusEl.className = "p-3 rounded-3 mb-3 bg-success-subtle border border-success-subtle text-success";
                statusEl.innerHTML = `
                    <div class="fw-bold mb-1">✓ Order Confirmed (Cash on Completion)!</div>
                    <div class="small text-dark font-monospace">Receipt ID: #${txnId}</div>
                    <div class="small text-muted mt-1">Generating official booking confirmation &amp; invoice...</div>
                `;

                document.getElementById('IsPaymentCompleted').value = 'false';
                document.getElementById('TransactionId').value = txnId;

                setTimeout(() => {
                    document.getElementById('bookingCreateForm').submit();
                }, 800);
            }, 1000);
        }

        // Quick Date Chip Helper
        function setQuickDate(daysFromNow) {
            const date = new Date();
            date.setDate(date.getDate() + daysFromNow);
            const yyyy = date.getFullYear();
            const mm = String(date.getMonth() + 1).padStart(2, '0');
            const dd = String(date.getDate()).padStart(2, '0');
            const formatted = `${yyyy}-${mm}-${dd}`;

            const dateInp = document.getElementById("bookingDateInput");
            if (dateInp) {
                dateInp.value = formatted;
                updateSidebarDate(formatted);
                fetchSlotsForPandit();
            }
        }

        function updateSidebarDate(dateStr) {
            if (!dateStr) return;
            const parts = dateStr.split('-');
            if (parts.length === 3) {
                const d = new Date(parts[0], parts[1] - 1, parts[2]);
                const options = { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' };
                document.getElementById('sidebarDateBadge').innerText = d.toLocaleDateString('en-IN', options);
            }
        }

        function selectMuhuratSlot(start, end, slotId, el) {
            document.getElementById('StartTime').value = start;
            document.getElementById('EndTime').value = end;
            document.getElementById('SlotId').value = slotId || 0;
            document.getElementById('sidebarTimeBadge').innerText = start + " - " + end;

            document.querySelectorAll('.muhurat-slot-card').forEach(c => c.classList.remove('active'));
            if (el) el.classList.add('active');
        }

        function fetchSlotsForPandit() {
            const panditId = document.getElementById("PanditId").value;
            const dateVal = document.getElementById("bookingDateInput").value;
            const slotMessage = document.getElementById("slotMessage");
            const container = document.getElementById("muhuratSlotsContainer");

            if (!panditId) {
                slotMessage.innerText = "Select a Pandit above to verify specific Muhurat availability.";
                return;
            }

            slotMessage.innerText = "Checking Pandit's auspicious Muhurat schedule for selected date...";

            fetch('@Url.Action("GetTimeSlots", "Booking")?panditId=' + encodeURIComponent(panditId) + '&date=' + encodeURIComponent(dateVal))
                .then(r => r.json())
                .then(data => {
                    if (data && data.length > 0) {
                        let html = '';
                        data.forEach((slot, index) => {
                            const isSelected = index === 0;
                            if (isSelected) {
                                document.getElementById('StartTime').value = slot.startTime;
                                document.getElementById('EndTime').value = slot.endTime;
                                document.getElementById('SlotId').value = slot.id > 0 ? slot.id : 0;
                                document.getElementById('sidebarTimeBadge').innerText = slot.startTime + " - " + slot.endTime;
                            }
                            const slotTitle = slot.name || 'Auspicious Muhurat';
                            html += `
                                <div class="col-sm-6 col-md-4">
                                    <div class="muhurat-slot-card p-2 rounded-3 border text-center cursor-pointer ${isSelected ? 'active' : ''}"
                                         onclick="selectMuhuratSlot('${slot.startTime}', '${slot.endTime}', ${slot.id > 0 ? slot.id : 0}, this)">
                                        <span class="d-block small text-saffron fw-bold" style="font-size: 11px;">✨ ${slotTitle}</span>
                                        <strong class="text-dark small d-block">${slot.startTime} - ${slot.endTime}</strong>
                                        <small class="text-muted" style="font-size: 10px;">${slot.isPredefined ? 'Pre-scheduled Slot' : 'Available for Booking'}</small>
                                    </div>
                                </div>`;
                        });
                        container.innerHTML = html;
                        slotMessage.innerText = "✓ " + data.length + " auspicious Muhurat slots available for this Pandit on " + (document.getElementById('sidebarDateBadge').innerText);
                    }
                })
                .catch(err => {
                    console.error(err);
                    slotMessage.innerText = "Standard auspicious Muhurats are active for this ceremony date.";
                });
        }

        document.addEventListener("DOMContentLoaded", function () {
            const dateInp = document.getElementById("bookingDateInput");
            if (dateInp) {
                updateSidebarDate(dateInp.value);
                dateInp.addEventListener("change", function () {
                    updateSidebarDate(this.value);
                    fetchSlotsForPandit();
                });
            }

            const panditDropdown = document.getElementById("PanditId");
            if (panditDropdown) {
                panditDropdown.addEventListener("change", function () {
                    fetchSlotsForPandit();
                });
            }
        });
    </script>
}
