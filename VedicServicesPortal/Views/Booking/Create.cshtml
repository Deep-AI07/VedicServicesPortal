@model VedicServicesPortal.ViewModels.BookingViewModel

@{
    var bookingSettings = SiteSettingsService.GetSettings();
    ViewData["Title"] = $"Book Vedic Ceremony - {bookingSettings.BrandName}";

    var cleanUpi = string.IsNullOrWhiteSpace(bookingSettings.UpiId) ? "vedicservices@upi" : bookingSettings.UpiId.Trim();
    var cleanBrand = string.IsNullOrWhiteSpace(bookingSettings.BrandName) ? "Vedic Services Portal" : bookingSettings.BrandName.Trim();
    var formattedPrice = Model.Service.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    var transactionRef = $"VEDA{Model.Service.ServiceId}{DateTime.UtcNow:MMddHHmm}";
    var transactionNote = $"{cleanBrand} - {Model.Service.ServiceName} Dakshina";

    var amountForPath = Model.Service.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var cleanBrandSimple = System.Text.RegularExpressions.Regex.Replace(cleanBrand, @"[^a-zA-Z0-9 ]", "").Trim();

    // Direct NPCI UPI Intent URI (for one-tap mobile buttons and in-app scanners)
    var upiPayload = $"upi://pay?pa={cleanUpi}&pn={Uri.EscapeDataString(cleanBrand)}&am={formattedPrice}&cu=INR&tn={Uri.EscapeDataString(transactionNote)}";

    // Universal Mobile Phone Camera Web Bridge URL
    // upi.pe requires the fixed amount directly in the path: https://upi.pe/[VPA]/[AMOUNT]
    // When scanned by any mobile camera, this guarantees the exact fixed amount is displayed and passed into the UPI apps
    var cameraBridgeUrl = $"https://upi.pe/{cleanUpi}/{amountForPath}?pn={Uri.EscapeDataString(cleanBrandSimple)}&tn={Uri.EscapeDataString(transactionNote)}";

    // Direct deep links for specific UPI applications with fixed amount
    var gpayPayload = $"tez://upi/pay?pa={cleanUpi}&pn={Uri.EscapeDataString(cleanBrand)}&am={formattedPrice}&cu=INR&tn={Uri.EscapeDataString(transactionNote)}";
    var phonepePayload = $"phonepe://pay?pa={cleanUpi}&pn={Uri.EscapeDataString(cleanBrand)}&am={formattedPrice}&cu=INR&tn={Uri.EscapeDataString(transactionNote)}";
    var paytmPayload = $"paytmmp://pay?pa={cleanUpi}&pn={Uri.EscapeDataString(cleanBrand)}&am={formattedPrice}&cu=INR&tn={Uri.EscapeDataString(transactionNote)}";

    // 1. Mobile Camera Scannable QR Code (Default - prompts link to open UPI app chooser)
    var cameraQrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=6&data={Uri.EscapeDataString(cameraBridgeUrl)}";

    // 2. Direct In-App Scanner QR Code (for scanning inside GPay, PhonePe, or Paytm app)
    var inAppQrUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=6&data={Uri.EscapeDataString(upiPayload)}";

    // Active default QR image
    var activeQrUrl = !string.IsNullOrWhiteSpace(bookingSettings.QrCodeImagePath) ? bookingSettings.QrCodeImagePath : cameraQrUrl;
}

<div class="container py-4 py-lg-5" style="max-width: 1100px;">

    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-transparent p-0 mb-0 small">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted-sacred">Home</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Service" asp-action="Index" class="text-decoration-none text-muted-sacred">Services</a>
            </li>
            <li class="breadcrumb-item active text-deep-maroon fw-bold" aria-current="page">
                Book Ceremony
            </li>
        </ol>
    </nav>

    <!-- HEADER TITLE -->
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center bg-sacred-container rounded-circle shadow-xs mb-2"
             style="width: 58px; height: 58px; font-size: 28px; color: #5f0006; border: 1px solid #dfbfbc;">
            🪔
        </div>
        <h1 class="display-5 fw-bold text-dark font-serif mb-1">
            Book Your Sacred <span class="text-primary-maroon font-serif">Ceremony</span>
        </h1>
        <p class="text-muted-sacred mx-auto mb-0" style="max-width: 580px;">
            Select your preferred Vedic Pandit, verify available auspicious Muhurat slots, and complete your Sankalp registration.
        </p>
    </div>

    <!-- VALIDATION SUMMARY -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 small"></div>

    <form asp-action="Create" method="post" id="bookingCreateForm">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ServiceId" />

        <div class="row g-4">
            <!-- LEFT COLUMN: FORM SECTIONS -->
            <div class="col-lg-8">
                <!-- 1. SELECTED SERVICE CARD -->
                <div class="stitch-card p-4 mb-4">
                    <div class="small fw-bold text-saffron text-uppercase mb-2" style="letter-spacing: 0.5px;">
                        Step 1 • Selected Ceremony
                    </div>
                    <div class="d-flex align-items-center gap-3 p-3 rounded-4 bg-sacred-low border border-sacred">
                        <div class="stitch-pillar-icon" style="width: 52px; height: 52px; font-size: 1.5rem;">
                            🪔
                        </div>
                        <div class="flex-grow-1">
                            <h3 class="fs-5 fw-bold text-dark font-serif mb-1">
                                @Model.Service.ServiceName
                            </h3>
                            <p class="small text-muted-sacred mb-0">
                                @Model.Service.Description
                            </p>
                        </div>
                        <div class="text-end ps-3 border-start border-sacred">
                            <small class="text-muted-sacred d-block" style="font-size: 11px;">Dakshina</small>
                            <strong class="fs-4 text-primary-maroon font-serif">₹@Model.Service.Price.ToString("N0")</strong>
                        </div>
                    </div>
                </div>

                <!-- 2. PANDIT SELECTION -->
                <div class="stitch-card p-4 mb-4">
                    <div class="small fw-bold text-saffron text-uppercase mb-2" style="letter-spacing: 0.5px;">
                        Step 2 • Select Gurukul Certified Pandit
                    </div>
                    <label asp-for="PanditId" class="stitch-label">
                        Choose Available Acharya / Purohit *
                    </label>
                    <select asp-for="PanditId" id="PanditId" class="stitch-form-control py-2 fs-6 mb-2" required>
                        <option value="">-- Click to select Pandit --</option>
                        @if (Model.Pandits != null)
                        {
                            @foreach (var pandit in Model.Pandits)
                            {
                                <option value="@pandit.PanditId">
                                    🧘 @pandit.Name — @pandit.Specialization (@pandit.Experience+ Yrs Exp)
                                </option>
                            }
                        }
                    </select>
                    <small class="text-muted-sacred" style="font-size: 12px;">
                        All pandits are verified Gurukul scholars rooted in traditional Shastras.
                    </small>
                </div>

                <!-- 3. CEREMONY DATE & AUSPICIOUS MUHURAT SELECTION -->
                <div class="stitch-card p-4 mb-4">
                    <div class="small fw-bold text-saffron text-uppercase mb-2" style="letter-spacing: 0.5px;">
                        Step 3 • Choose Ceremony Date &amp; Auspicious Muhurat Time
                    </div>

                    <!-- Date Selection Input -->
                    <div class="mb-3">
                        <label asp-for="BookingDate" class="stitch-label">
                            📅 Select Auspicious Ceremony Date *
                        </label>
                        <input type="date"
                               asp-for="BookingDate"
                               id="bookingDateInput"
                               class="stitch-form-control py-2 fs-6 mb-2"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@(Model.BookingDate != default(DateTime) ? Model.BookingDate.ToString("yyyy-MM-dd") : DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))"
                               required />

                        <!-- Quick Date Quick-Select Chips -->
                        <div class="d-flex flex-wrap gap-2 mt-1 mb-2">
                            <button type="button" class="badge rounded-pill bg-sacred-low text-deep-maroon border border-sacred px-2 py-1 small cursor-pointer" onclick="setQuickDate(1)">
                                Tomorrow
                            </button>
                            <button type="button" class="badge rounded-pill bg-sacred-low text-deep-maroon border border-sacred px-2 py-1 small cursor-pointer" onclick="setQuickDate(2)">
                                In 2 Days
                            </button>
                            <button type="button" class="badge rounded-pill bg-sacred-low text-deep-maroon border border-sacred px-2 py-1 small cursor-pointer" onclick="setQuickDate(3)">
                                In 3 Days
                            </button>
                            <button type="button" class="badge rounded-pill bg-sacred-low text-deep-maroon border border-sacred px-2 py-1 small cursor-pointer" onclick="setQuickDate(7)">
                                Next Week
                            </button>
                        </div>
                    </div>

                    <!-- Auspicious Muhurat Time Slot Picker -->
                    <div class="mb-2">
                        <label class="stitch-label">
                            🕐 Select Auspicious Muhurat Time Slot *
                        </label>

                        <!-- Hidden fields bound to model -->
                        <input type="hidden" asp-for="SlotId" id="SlotId" value="@Model.SlotId" />
                        <input type="hidden" asp-for="StartTime" id="StartTime" value="@(string.IsNullOrEmpty(Model.StartTime) ? "09:00 AM" : Model.StartTime)" />
                        <input type="hidden" asp-for="EndTime" id="EndTime" value="@(string.IsNullOrEmpty(Model.EndTime) ? "11:00 AM" : Model.EndTime)" />

                        <!-- Muhurat Slot Selection Cards -->
                        <div class="row g-2 mb-2" id="muhuratSlotsContainer">
                            <div class="col-sm-6 col-md-4">
                                <div class="muhurat-slot-card p-2 rounded-3 border text-center cursor-pointer" data-start="06:00 AM" data-end="08:00 AM" onclick="selectMuhuratSlot('06:00 AM', '08:00 AM', 0, this)">
                                    <span class="d-block small text-saffron fw-bold" style="font-size: 11px;">🌅 Brahma Muhurat</span>
                                    <strong class="text-dark small d-block">06:00 AM - 08:00 AM</strong>
                                    <small class="text-muted" style="font-size: 10px;">Spiritual Awakening</small>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="muhurat-slot-card active p-2 rounded-3 border text-center cursor-pointer" data-start="09:00 AM" data-end="11:00 AM" onclick="selectMuhuratSlot('09:00 AM', '11:00 AM', 0, this)">
                                    <span class="d-block small text-saffron fw-bold" style="font-size: 11px;">🪔 Auspicious Morning</span>
                                    <strong class="text-dark small d-block">09:00 AM - 11:00 AM</strong>
                                    <small class="text-muted" style="font-size: 10px;">Shubh Labh</small>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="muhurat-slot-card p-2 rounded-3 border text-center cursor-pointer" data-start="11:45 AM" data-end="01:45 PM" onclick="selectMuhuratSlot('11:45 AM', '01:45 PM', 0, this)">
                                    <span class="d-block small text-saffron fw-bold" style="font-size: 11px;">✨ Abhijit Muhurat</span>
                                    <strong class="text-dark small d-block">11:45 AM - 01:45 PM</strong>
                                    <small class="text-muted" style="font-size: 10px;">Universal Victory</small>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="muhurat-slot-card p-2 rounded-3 border text-center cursor-pointer" data-start="02:30 PM" data-end="04:30 PM" onclick="selectMuhuratSlot('02:30 PM', '04:30 PM', 0, this)">
                                    <span class="d-block small text-saffron fw-bold" style="font-size: 11px;">☀️ Afternoon Amrit</span>
                                    <strong class="text-dark small d-block">02:30 PM - 04:30 PM</strong>
                                    <small class="text-muted" style="font-size: 10px;">Prosperity Havan</small>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="muhurat-slot-card p-2 rounded-3 border text-center cursor-pointer" data-start="05:00 PM" data-end="07:00 PM" onclick="selectMuhuratSlot('05:00 PM', '07:00 PM', 0, this)">
                                    <span class="d-block small text-saffron fw-bold" style="font-size: 11px;">🌄 Sandhya Twilight</span>
                                    <strong class="text-dark small d-block">05:00 PM - 07:00 PM</strong>
                                    <small class="text-muted" style="font-size: 10px;">Evening Aarti &amp; Jaap</small>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="muhurat-slot-card p-2 rounded-3 border text-center cursor-pointer" data-start="07:00 PM" data-end="09:00 PM" onclick="selectMuhuratSlot('07:00 PM', '09:00 PM', 0, this)">
                                    <span class="d-block small text-saffron fw-bold" style="font-size: 11px;">🌙 Pradosh Kaal</span>
                                    <strong class="text-dark small d-block">07:00 PM - 09:00 PM</strong>
                                    <small class="text-muted" style="font-size: 10px;">Shiva &amp; Katha Rite</small>
                                </div>
                            </div>
                        </div>

                        <div id="slotMessage" class="small fw-semibold text-muted-sacred mt-2">
                            Select your desired ceremony date and preferred Muhurat time for the Pandit.
                        </div>
                    </div>
                </div>

                <!-- 4. SERVICE ADDRESS / YAJMAN VENUE -->
                <div class="stitch-card p-4 mb-4">
                    <div class="small fw-bold text-saffron text-uppercase mb-2" style="letter-spacing: 0.5px;">
                        Step 4 • Ceremony Address &amp; Venue Details
                    </div>
                    <label asp-for="Address" class="stitch-label">
                        Complete Residence / Office / Temple Address *
                    </label>
                    <textarea asp-for="Address"
                              class="stitch-form-control"
                              rows="3"
                              placeholder="e.g. Flat 402, Shivam Enclave, Indiranagar, Bengaluru - 560038"
                              required></textarea>
                    <small class="text-muted-sacred" style="font-size: 12px;">
                        Our Pandit will arrive at this address along with consecrated puja samagri prior to the scheduled Muhurat.
                    </small>
                </div>

                <!-- 5. DAKSHINA PAYMENT METHOD SELECTION -->
                <div class="stitch-card p-4 mb-4">
                    <div class="small fw-bold text-saffron text-uppercase mb-2" style="letter-spacing: 0.5px;">
                        Step 5 • Choose Sacred Dakshina Payment Method
                    </div>
                    <p class="small text-muted-sacred mb-3">
                        ⚡ Consecrated Shastric Vidhi: Your ceremony order will be officially registered and your sacred Invoice generated upon selecting your payment method (UPI QR, Card, or Cash on Completion).
                    </p>

                    <!-- Hidden inputs bound to model -->
                    <input type="hidden" asp-for="PaymentMethod" id="selectedPaymentMethod" value="UPI" />
                    <input type="hidden" asp-for="TransactionId" id="TransactionId" value="" />
                    <input type="hidden" asp-for="IsPaymentCompleted" id="IsPaymentCompleted" value="false" />

                    <!-- Payment Option Tabs/Cards -->
                    <div class="row g-3 mb-4">
                        <!-- Option 1: UPI with QR -->
                        <div class="col-md-4">
                            <div class="payment-method-card active p-3 rounded-4 border text-center h-100 cursor-pointer"
                                 id="optUpi"
                                 onclick="selectPaymentMethod('UPI')">
                                <div class="fs-2 mb-2">📱</div>
                                <h4 class="fs-6 fw-bold mb-1 font-serif text-dark">UPI with Dynamic QR</h4>
                                <small class="text-muted-sacred d-block" style="font-size: 11px;">Instant QR scan (GPay, PhonePe, Paytm)</small>
                                <span class="badge rounded-pill bg-success-subtle text-success mt-2 small">✓ Zero Fee • Instant</span>
                            </div>
                        </div>

                        <!-- Option 2: Card Payment -->
                        <div class="col-md-4">
                            <div class="payment-method-card p-3 rounded-4 border text-center h-100 cursor-pointer"
                                 id="optCard"
                                 onclick="selectPaymentMethod('Card')">
                                <div class="fs-2 mb-2">💳</div>
                                <h4 class="fs-6 fw-bold mb-1 font-serif text-dark">Debit / Credit Card</h4>
                                <small class="text-muted-sacred d-block" style="font-size: 11px;">Visa, MasterCard, RuPay</small>
                                <span class="badge rounded-pill bg-primary-subtle text-primary mt-2 small">✓ 256-Bit SSL Encrypted</span>
                            </div>
                        </div>

                        <!-- Option 3: Cash on Completion -->
                        <div class="col-md-4">
                            <div class="payment-method-card p-3 rounded-4 border text-center h-100 cursor-pointer"
                                 id="optCash"
                                 onclick="selectPaymentMethod('Cash on Completion')">
                                <div class="fs-2 mb-2">🪔</div>
                                <h4 class="fs-6 fw-bold mb-1 font-serif text-dark">Cash on Completion</h4>
                                <small class="text-muted-sacred d-block" style="font-size: 11px;">Pay Dakshina directly to Panditji after puja</small>
                                <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis mt-2 small">✓ Zero Advance • In-Person</span>
                            </div>
                        </div>
                    </div>

                    <!-- DETAIL BOXES BASED ON SELECTION -->

                    <!-- 1. UPI with QR Content -->
                    <div id="boxUpi" class="p-4 rounded-4 bg-sacred-low border border-sacred shadow-xs">
                        <div class="row align-items-center g-4">
                            <!-- Left Column: High-Res QR Code Card with Scanner Mode Switcher -->
                            <div class="col-lg-5 text-center">
                                <div class="p-3 bg-white rounded-4 shadow-sm border border-sacred d-inline-block position-relative w-100" style="max-width: 265px;">
                                    
                                    <!-- QR Scanner Mode Selector -->
                                    <div class="d-flex p-1 rounded-pill bg-sacred-low border border-sacred mb-2.5">
                                        <button type="button" class="btn btn-sm rounded-pill fw-bold py-1 px-2 flex-fill" id="btnModeCamera" onclick="switchQrMode('camera')" style="font-size: 10px; background: #801818; color: #ffffff;">
                                            📷 Phone Camera
                                        </button>
                                        <button type="button" class="btn btn-sm rounded-pill fw-bold py-1 px-2 flex-fill text-dark" id="btnModeInApp" onclick="switchQrMode('inapp')" style="font-size: 10px; background: transparent;">
                                            📱 In-App Scanner
                                        </button>
                                    </div>

                                    <div class="position-relative d-inline-block">
                                        <img src="@activeQrUrl"
                                             id="checkoutQrImg"
                                             data-camera-src="@cameraQrUrl"
                                             data-inapp-src="@inAppQrUrl"
                                             alt="Scan UPI QR Code to Pay Dakshina"
                                             class="img-fluid rounded-3 border"
                                             style="width: 200px; height: 200px; object-fit: contain;" />
                                        <span class="badge bg-success text-white rounded-pill position-absolute" id="checkoutQrLiveBadge" style="top: -6px; right: -6px; font-size: 9px; box-shadow: 0 2px 6px rgba(0,0,0,0.15);">
                                            ● CAMERA READY
                                        </span>
                                    </div>

                                    <div class="fs-6 fw-bold text-dark mt-2 font-serif">
                                        ₹@Model.Service.Price.ToString("N0")
                                    </div>
                                    <div class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded-pill my-1" style="font-size: 10px;">
                                        🔒 Fixed Amount (Non-Editable)
                                    </div>

                                    <div class="small text-muted-sacred mt-1 px-1" id="qrModeNotice" style="font-size: 10px; line-height: 1.35;">
                                        Point your <strong>Mobile Camera</strong> → Tap link → Select your UPI app (GPay, PhonePe, Paytm)
                                    </div>

                                    <div class="d-flex justify-content-center gap-1 mt-2">
                                        <span class="badge bg-light text-dark border px-1.5 py-0.5" style="font-size: 9px;">Google Pay</span>
                                        <span class="badge bg-light text-dark border px-1.5 py-0.5" style="font-size: 9px;">PhonePe</span>
                                        <span class="badge bg-light text-dark border px-1.5 py-0.5" style="font-size: 9px;">Paytm</span>
                                        <span class="badge bg-light text-dark border px-1.5 py-0.5" style="font-size: 9px;">BHIM</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Intent Actions & Instructions -->
                            <div class="col-lg-7">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">📱</span>
                                        <strong class="text-dark">Instant UPI Dakshina Consecration</strong>
                                    </div>
                                    <span class="badge bg-sacred-container text-deep-maroon border border-sacred small" style="font-size: 10.5px;">
                                        Locked: ₹@Model.Service.Price.ToString("N0")
                                    </span>
                                </div>

                                <!-- ONE-TAP PRIMARY MOBILE BUTTON (Triggers native OS UPI App Chooser) -->
                                <a href="@upiPayload" class="btn-stitch-primary w-100 py-2.5 px-3 mb-2.5 d-flex align-items-center justify-content-center gap-2 text-decoration-none shadow-sm fw-bold" style="font-size: 14px;">
                                    <span>🚀 Open in UPI App (GPay / PhonePe / Paytm)</span>
                                </a>

                                <!-- BALANCED 3-COLUMN DIRECT APP SHORTCUTS -->
                                <div class="row g-2 mb-3 text-center">
                                    <div class="col-4">
                                        <a href="@gpayPayload" class="btn btn-sm btn-outline-sacred w-100 py-1.5 px-1 d-flex flex-column align-items-center justify-content-center text-decoration-none rounded-3 shadow-xs bg-white hover-elevate">
                                            <strong class="text-dark" style="font-size: 11px;">Google Pay</strong>
                                            <small class="text-muted-sacred" style="font-size: 9.5px;">Auto ₹@Model.Service.Price.ToString("N0")</small>
                                        </a>
                                    </div>
                                    <div class="col-4">
                                        <a href="@phonepePayload" class="btn btn-sm btn-outline-sacred w-100 py-1.5 px-1 d-flex flex-column align-items-center justify-content-center text-decoration-none rounded-3 shadow-xs bg-white hover-elevate">
                                            <strong style="color: #5f259f; font-size: 11px;">PhonePe</strong>
                                            <small class="text-muted-sacred" style="font-size: 9.5px;">Auto ₹@Model.Service.Price.ToString("N0")</small>
                                        </a>
                                    </div>
                                    <div class="col-4">
                                        <a href="@paytmPayload" class="btn btn-sm btn-outline-sacred w-100 py-1.5 px-1 d-flex flex-column align-items-center justify-content-center text-decoration-none rounded-3 shadow-xs bg-white hover-elevate">
                                            <strong style="color: #00b9f5; font-size: 11px;">Paytm</strong>
                                            <small class="text-muted-sacred" style="font-size: 9.5px;">Auto ₹@Model.Service.Price.ToString("N0")</small>
                                        </a>
                                    </div>
                                </div>

                                <!-- INSTRUCTIONS FOR AUTO-FETCH & NON-EDITABLE PRICE -->
                                <div class="p-2.5 rounded-3 bg-white border border-sacred mb-3 small" style="font-size: 11.5px; line-height: 1.5;">
                                    <div class="d-flex align-items-start gap-2 mb-1.5">
                                        <span class="text-primary fs-6">📱</span>
                                        <div><strong>On Mobile:</strong> Tap <em>"Open in UPI App"</em> to pay directly. The payment amount (<strong>₹@Model.Service.Price.ToString("N0")</strong>) is fetched automatically and cannot be changed.</div>
                                    </div>
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="text-success fs-6">📷</span>
                                        <div><strong>Scanning QR:</strong> Scan using the QR scanner inside <strong>Google Pay, PhonePe, or Paytm</strong>. The ₹@Model.Service.Price.ToString("N0") dakshina amount is locked automatically.</div>
                                    </div>
                                </div>

                                <!-- VPA DISPLAY WITH COPY BUTTON -->
                                <div class="p-2.5 rounded-3 bg-white border border-sacred mb-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted-sacred d-block" style="font-size: 10px;">Sanctum UPI VPA:</small>
                                        <strong class="text-primary-maroon font-monospace" style="font-size: 13px;" id="portalUpiIdText">@(bookingSettings.UpiId)</strong>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-sacred py-1 px-2.5 small rounded-pill fw-semibold" onclick="copyUpiId()">
                                        📋 Copy VPA
                                    </button>
                                </div>

                                <!-- UTR INPUT -->
                                <div>
